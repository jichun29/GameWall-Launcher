<Window x:Class="GameWall.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用 GameWall"
        Width="620" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <Border Style="{StaticResource Dialog.Card}" Margin="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部渐变头图 -->
            <Border Grid.Row="0" CornerRadius="13,13,0,0" Height="96">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource Color.HeroStart}" Offset="0" />
                        <GradientStop Color="{DynamicResource Color.HeroEnd}" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="26,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="欢迎来到 GameWall" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.HeroText}" />
                        <TextBlock Text="把散落各处的游戏，收进一面墙。"
                                   Foreground="{DynamicResource Brush.HeroTextDim}" Margin="0,6,0,0" />
                    </StackPanel>
                    <Button Content="✕" Style="{StaticResource Button.Icon}" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Margin="0,14,-6,0" Click="Skip_Click" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Style="{StaticResource ScrollViewer.Clean}" Padding="26,18,26,0">
                <StackPanel>
                    <TextBlock Text="三步就能用起来" Style="{StaticResource Text.Title}" FontSize="15"
                               Margin="0,0,0,12" />

                    <!-- 步骤 1 -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                Background="{DynamicResource Brush.AccentSoft}" VerticalAlignment="Top">
                            <TextBlock Text="1" Foreground="{DynamicResource Brush.Accent}" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="添加游戏" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" Margin="0,3,0,0"
                                       Text="点顶部「＋ 添加游戏」选 exe，或者直接把桌面上的快捷方式拖进窗口。" />
                        </StackPanel>
                    </Grid>

                    <!-- 步骤 2 -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                Background="{DynamicResource Brush.AccentSoft}" VerticalAlignment="Top">
                            <TextBlock Text="2" Foreground="{DynamicResource Brush.Accent}" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="认一下封面" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" Margin="0,3,0,0"
                                       Text="会先从 exe 里提取图标。想换成正式封面，右键卡片 →「编辑信息」→「选择图片」。封面会被复制到数据目录，原图删掉也不影响。" />
                        </StackPanel>
                    </Grid>

                    <!-- 步骤 3 -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                Background="{DynamicResource Brush.AccentSoft}" VerticalAlignment="Top">
                            <TextBlock Text="3" Foreground="{DynamicResource Brush.Accent}" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="双击开玩" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" Margin="0,3,0,0"
                                       Text="双击封面即可启动。拖动卡片可以排序，顶部搜索框能实时过滤，右键还有打开安装目录、存档目录等操作。" />
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="14,12"
                            Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="顺带一提" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource Brush.TextDim}" />
                            <TextBlock Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="• 游戏多的话，点「⟳ 扫描」自动找出硬盘里的游戏&#10;• 装了 Steam / Epic / GOG 的话，「⤓ 平台导入」一键读取&#10;• 所有数据都在本机 %AppData%\GameWall\，不联网，不上传" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                    Padding="26,14">
                <Grid>
                    <TextBlock Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center"
                               Text="按 Ctrl+V 也能把复制的文件路径加进来" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="以后再说" Click="Skip_Click" Margin="0,0,10,0" Padding="18,8" />
                        <Button Content="开始添加游戏" Style="{StaticResource Button.Accent}"
                                Click="Start_Click" Padding="22,8" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
