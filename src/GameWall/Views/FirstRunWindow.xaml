<Window x:Class="GameWall.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用 GameWall"
        Width="660" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        MouseLeftButtonDown="Header_MouseLeftButtonDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Style="{StaticResource Dialog.Card}" Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部头图：深空渐变 + 品牌光晕 -->
            <Border Grid.Row="0" CornerRadius="16,16,0,0" Height="128" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource Color.HeroStart}" Offset="0" />
                        <GradientStop Color="{DynamicResource Color.HeroEnd}" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <!-- 右上角冷光 -->
                    <Ellipse Width="360" Height="360" HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-210,-90,0" Opacity="0.5">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="{DynamicResource Color.Glow}" Offset="0" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Grid Margin="32,0,24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0" Width="72" Height="72" Margin="0,0,22,0"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="pack://application:,,,/Assets/logo-256.png">
                            <Image.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.75"
                                                  Color="{DynamicResource Color.Glow}" />
                            </Image.Effect>
                        </Image>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="欢迎来到 GameWall" FontSize="25" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.HeroText}" />
                            <TextBlock Text="把散落各处的游戏，收进一面墙。"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource Brush.HeroTextDim}" Margin="1,9,0,0" />
                        </StackPanel>

                        <Button Grid.Column="2" Content="✕" Style="{StaticResource Button.Icon}"
                                VerticalAlignment="Top" Margin="0,18,0,0" Click="Skip_Click" />
                    </Grid>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Style="{StaticResource ScrollViewer.Clean}" Padding="32,26,32,0">
                <StackPanel>
                    <TextBlock Text="三步就能用起来" Style="{StaticResource Text.Section}" FontSize="11"
                               Margin="0,0,0,18" />

                    <!-- 步骤 1 -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                Background="{DynamicResource Brush.AccentSoft}"
                                BorderBrush="{DynamicResource Brush.AccentGlow}" BorderThickness="1"
                                VerticalAlignment="Top">
                            <TextBlock Text="1" Foreground="{DynamicResource Brush.Accent}" FontWeight="Bold"
                                       FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="添加游戏" FontWeight="SemiBold" FontSize="13.5" />
                            <TextBlock Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="点顶部「＋ 添加游戏」选 exe，或者直接把桌面上的快捷方式拖进窗口。Steam 的快捷方式也能识别。" />
                        </StackPanel>
                    </Grid>

                    <!-- 步骤 2 -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                Background="{DynamicResource Brush.AccentSoft}"
                                BorderBrush="{DynamicResource Brush.AccentGlow}" BorderThickness="1"
                                VerticalAlignment="Top">
                            <TextBlock Text="2" Foreground="{DynamicResource Brush.Accent}" FontWeight="Bold"
                                       FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="认一下封面" FontWeight="SemiBold" FontSize="13.5" />
                            <TextBlock Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="会先从 exe 里提取图标当徽标。想换成正式封面，右键卡片 →「编辑信息」→「选择图片」。封面会被复制到数据目录，原图删掉也不影响。" />
                        </StackPanel>
                    </Grid>

                    <!-- 步骤 3 -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                Background="{DynamicResource Brush.AccentSoft}"
                                BorderBrush="{DynamicResource Brush.AccentGlow}" BorderThickness="1"
                                VerticalAlignment="Top">
                            <TextBlock Text="3" Foreground="{DynamicResource Brush.Accent}" FontWeight="Bold"
                                       FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="双击开玩" FontWeight="SemiBold" FontSize="13.5" />
                            <TextBlock Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="双击封面即可启动。拖动卡片可以排序，顶部搜索框能实时过滤，右键还有打开安装目录、存档目录等操作。" />
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="12" Padding="18,15"
                            BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1"
                            Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="顺带一提" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource Brush.Accent}" />
                            <TextBlock Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" Margin="0,9,0,0"
                                       LineHeight="21"
                                       Text="• 游戏多的话，点「⟳ 扫描」自动找出硬盘里的游戏&#10;• 装了 Steam / Epic / GOG 的话，「⤓ 平台导入」一键读取&#10;• 所有数据都在本机 %AppData%\GameWall\，不联网，不上传" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部操作条：不透明背景，避免滚动内容从按钮背后透出来 -->
            <Border Grid.Row="2" Background="{DynamicResource Brush.BarGradient}"
                    BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="0,1,0,0"
                    Padding="32,16">
                <Grid>
                    <TextBlock Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center"
                               Text="按 Ctrl+V 也能把复制的文件路径加进来" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="以后再说" Click="Skip_Click" Margin="0,0,12,0"
                                Height="{StaticResource Size.ControlHeight}" Padding="20,0" />
                        <Button Content="开始添加游戏" Style="{StaticResource Button.Accent}"
                                Click="Start_Click" Height="{StaticResource Size.ControlHeight}" Padding="26,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
