<Window x:Class="GameWall.Views.Dialogs.TidyDesktopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GameWall.Converters"
        Title="整理桌面"
        Width="800" Height="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
    </Window.Resources>

    <Border Style="{StaticResource Dialog.Card}" Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ══════ 标题栏 ══════ -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="26,22,18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="整理桌面" Style="{StaticResource Text.Title}" FontSize="18" />
                        <TextBlock Text="已经收进游戏墙的游戏，桌面上的快捷方式可以挪走了"
                                   Style="{StaticResource Text.Dim}" FontSize="12" Margin="1,7,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕" Style="{StaticResource Button.Icon}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Click="Cancel_Click" />
                </Grid>
            </Border>

            <!-- ══════ 说明条 ══════ -->
            <Border Grid.Row="1" Margin="26,16,26,0" CornerRadius="12" Padding="16,13"
                    Background="{DynamicResource Brush.SurfaceAlt}"
                    BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" LineHeight="19" FontSize="12.5"
                               Foreground="{DynamicResource Brush.Text}">
                        <Run Text="快捷方式" /><Run Text="不会删除" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Accent}" /><Run Text="，只会移动到一个备份文件夹里。" />
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" LineHeight="19" FontSize="12" Margin="0,7,0,0"
                               Foreground="{DynamicResource Brush.TextDim}">
                        <Run Text="备份位置：%AppData%\GameWall\desktop-backup\ ——随时能在设置里还原回来。" />
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" LineHeight="19" FontSize="12" Margin="0,5,0,0"
                               Foreground="{DynamicResource Brush.TextDim}">
                        <Run Text="只有「已收录」会被勾上；没导入过的游戏和公共桌面的快捷方式不会动。" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ══════ 快捷方式列表 ══════ -->
            <Grid Grid.Row="2" Margin="26,16,26,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Grid.Column="0" Style="{StaticResource Text.Dim}"
                               FontSize="12" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Text="正在检查桌面…" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="全选" Height="30" Padding="14,0" Margin="0,0,8,0" Click="SelectAll_Click" />
                        <Button Content="全不选" Height="30" Padding="14,0" Margin="0,0,8,0" Click="SelectNone_Click" />
                        <Button Content="重新检查" Height="30" Padding="14,0" Click="Refresh_Click" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" CornerRadius="12" BorderThickness="1"
                        BorderBrush="{DynamicResource Brush.Border}"
                        Background="{DynamicResource Brush.Surface}"
                        ClipToBounds="True">
                    <Grid>
                        <ListBox x:Name="ShortcutList" Background="Transparent" BorderThickness="0"
                                 Padding="6"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="12,10" />
                                    <Setter Property="Margin" Value="0,0,0,2" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="9"
                                                        Padding="{TemplateBinding Padding}"
                                                        BorderThickness="1" BorderBrush="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background"
                                                                Value="{DynamicResource Brush.CardHover}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid IsEnabled="{Binding Selectable}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Margin="0,0,12,0" />

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                       FontSize="13" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding TargetText}" FontSize="11"
                                                       Style="{StaticResource Text.Subtitle}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <Border Grid.Column="2" CornerRadius="8" Padding="8,3"
                                                VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSoft}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding InLibrary}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentGlow}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}" FontSize="10.5"
                                                       Foreground="{DynamicResource Brush.TextDim}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="EmptyHint"
                                   Text="桌面上没有找到 .lnk / .url 快捷方式。"
                                   Style="{StaticResource Text.Dim}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ══════ 底部操作条 ══════ -->
            <Border Grid.Row="3" Background="{DynamicResource Brush.BarGradient}"
                    BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="0,1,0,0"
                    Padding="26,16" Margin="0,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="HintText" Grid.Column="0" Style="{StaticResource Text.Subtitle}"
                               VerticalAlignment="Center" Margin="0,0,18,0"
                               TextTrimming="CharacterEllipsis"
                               Text="挪走之后，以后从 GameWall 启动游戏就行。" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="取消" Click="Cancel_Click" Margin="0,0,12,0"
                                Height="{StaticResource Size.ControlHeight}" Padding="22,0" />
                        <Button x:Name="TidyButton" Content="移到备份文件夹"
                                Style="{StaticResource Button.Accent}" Click="Tidy_Click"
                                Height="{StaticResource Size.ControlHeight}" Padding="26,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
