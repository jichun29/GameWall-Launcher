<Window x:Class="GameWall.Views.Dialogs.GameToolboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="游戏工具箱"
        Width="1000" Height="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        MinWidth="880" MinHeight="620">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 一条优化项：左侧勾选，中间标题与说明，右侧状态与还原 -->
        <DataTemplate x:Key="TweakItemTemplate">
            <Border Margin="0,0,0,8" Padding="14,12" CornerRadius="12"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="0,2,12,0"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
                            <Border CornerRadius="7" Padding="7,1" Margin="9,0,0,0" VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.SurfaceAlt}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                <TextBlock Text="{Binding RiskText}" FontSize="10.5"
                                           Foreground="{DynamicResource Brush.TextFaint}" />
                            </Border>
                            <Border CornerRadius="7" Padding="7,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.SurfaceAlt}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                    Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding AdminBadge}" FontSize="10.5"
                                           Foreground="{DynamicResource Brush.Warning}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Summary}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                   LineHeight="19" Foreground="{DynamicResource Brush.TextDim}" />
                        <TextBlock Text="{Binding Effect}" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                   LineHeight="18" Foreground="{DynamicResource Brush.TextFaint}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="14,0,0,0">
                        <TextBlock Text="{Binding StateText}" FontSize="11.5" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource Brush.TextFaint}" Margin="0,0,0,6" />
                        <Button Content="还原" Height="28" Padding="14,0" FontSize="11.5"
                                Style="{StaticResource Button.Base}"
                                Visibility="{Binding IsRevertVisible, Converter={StaticResource BoolToVis}}"
                                Click="RevertOne_Click" Tag="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 硬件分区里的一行 -->
        <DataTemplate x:Key="HardwareRowTemplate">
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" FontSize="12"
                           Foreground="{DynamicResource Brush.TextDim}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5"
                           Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="2" Text="{Binding Hint}" FontSize="11" Margin="12,0,0,0"
                           Foreground="{DynamicResource Brush.TextFaint}"
                           Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DataTemplate>

        <!-- 硬件分区卡片 -->
        <DataTemplate x:Key="HardwareSectionTemplate">
            <Border Margin="0,0,0,12" Padding="18,15" CornerRadius="12"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{Binding Glyph}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource HardwareRowTemplate}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 硬件建议 -->
        <DataTemplate x:Key="AdviceTemplate">
            <Border Margin="0,0,0,8" Padding="14,11" CornerRadius="10"
                    Background="{DynamicResource Brush.SurfaceAlt}"
                    BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Text="{Binding Detail}" FontSize="11.5" Margin="0,5,0,0" TextWrapping="Wrap"
                               LineHeight="18" Foreground="{DynamicResource Brush.TextDim}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════ 标题栏 ═══════ -->
        <Border Grid.Row="0" Height="60" Background="{DynamicResource Brush.BarGradient}"
                BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid Margin="24,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="游戏工具箱" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Text="本机硬件 · 游戏优化方案 · 电源方案，全部可还原"
                               FontSize="10.5" Margin="1,3,0,0"
                               Foreground="{DynamicResource Brush.TextFaint}" />
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Style="{StaticResource Button.Icon}"
                        Click="Close_Click" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ═══════ 状态条 ═══════ -->
        <Border Grid.Row="1" Padding="24,10" Background="{DynamicResource Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center"
                           TextWrapping="Wrap" FontSize="11.5"
                           Foreground="{DynamicResource Brush.TextDim}" />
                <TextBlock x:Name="ElevationText" Grid.Column="1" VerticalAlignment="Center"
                           Margin="16,0,0,0" FontSize="11"
                           Foreground="{DynamicResource Brush.TextFaint}"
                           TextTrimming="CharacterEllipsis" MaxWidth="380" />
            </Grid>
        </Border>

        <!-- ═══════ 主体：两列 ═══════ -->
        <Grid Grid.Row="2" Margin="24,16,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左列：硬件信息 -->
            <Grid Grid.Column="0" Margin="0,0,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="这台电脑" Style="{StaticResource Text.Section}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="重新检测" Height="30" Padding="14,0" FontSize="11.5"
                            Margin="0,0,8,0" Click="Refresh_Click" />
                    <Button Grid.Column="2" Content="导出" Height="30" Padding="14,0" FontSize="11.5"
                            Click="Export_Click" />
                </Grid>

                <ScrollViewer Grid.Row="1" Style="{StaticResource ScrollViewer.Clean}"
                              VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Sections}"
                                      ItemTemplate="{StaticResource HardwareSectionTemplate}" />

                        <TextBlock Text="针对这台机器的建议" Style="{StaticResource Text.Section}"
                                   Margin="0,4,0,10" />
                        <ItemsControl ItemsSource="{Binding Advices}"
                                      ItemTemplate="{StaticResource AdviceTemplate}" />
                        <TextBlock Text="以上只是根据硬件给出的提示，不会自动改任何设置。"
                                   FontSize="11" Margin="0,2,0,24" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.TextFaint}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 右列：优化项 + 电源方案 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 工具条 -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="CategoryBox" Grid.Column="0" Width="150" Height="32"
                              SelectionChanged="Category_Changed" />
                    <CheckBox x:Name="AppliedOnlyBox" Grid.Column="1" Content="只看已应用"
                              Margin="14,0,0,0" VerticalAlignment="Center"
                              Checked="AppliedOnly_Changed" Unchecked="AppliedOnly_Changed" />
                    <CheckBox x:Name="HighRiskBox" Grid.Column="2" Content="包含高风险项"
                              VerticalAlignment="Center" ToolTip="勾选后才允许应用标记为高风险的条目"
                              Checked="HighRisk_Changed" Unchecked="HighRisk_Changed" />
                </Grid>

                <!-- 预设 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="一键套用" Style="{StaticResource Text.Section}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="推荐" Height="28" Padding="14,0" FontSize="11.5" Margin="0,0,8,0"
                            Tag="推荐" Click="Preset_Click" />
                    <Button Content="竞技（低延迟）" Height="28" Padding="14,0" FontSize="11.5" Margin="0,0,8,0"
                            Tag="竞技（低延迟）" Click="Preset_Click" />
                    <Button Content="画质（图形优化）" Height="28" Padding="14,0" FontSize="11.5"
                            Tag="画质（图形优化）" Click="Preset_Click" />
                </StackPanel>

                <!-- 优化项列表 -->
                <ListBox x:Name="TweakList" Grid.Row="2"
                         ItemsSource="{Binding FilteredTweaks}"
                         ItemTemplate="{StaticResource TweakItemTemplate}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- 电源方案 + 操作按钮 -->
                <StackPanel Grid.Row="3" Margin="0,14,0,0">
                    <TextBlock Text="电源方案" Style="{StaticResource Text.Section}" Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="PowerPlanBox" Grid.Column="0" Height="32" Margin="0,0,10,0" />
                        <Button Grid.Column="1" Content="应用" Height="32" Padding="16,0" FontSize="11.5"
                                Margin="0,0,8,0" Click="ActivatePlan_Click" />
                        <Button Grid.Column="2" Content="卓越性能" Height="32" Padding="16,0" FontSize="11.5"
                                Margin="0,0,8,0" Click="Ultimate_Click"
                                ToolTip="Win10 1803 起内置但默认隐藏，找不到就自动复制一份" />
                        <Button Grid.Column="3" Content="还原默认" Height="32" Padding="16,0" FontSize="11.5"
                                Click="Balanced_Click" ToolTip="切回系统默认的「平衡」方案" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ═══════ 底部操作条 ═══════ -->
        <Border Grid.Row="3" Background="{DynamicResource Brush.BarGradient}"
                BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="0,1,0,0"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="AppliedSummary" Grid.Column="0" VerticalAlignment="Center"
                           FontSize="11.5" Foreground="{DynamicResource Brush.TextDim}"
                           TextTrimming="CharacterEllipsis" />

                <Button Grid.Column="1" Content="全部还原" Height="{StaticResource Size.ControlHeight}"
                        Padding="20,0" Margin="0,0,10,0" Click="RevertAll_Click"
                        ToolTip="把本工具改过的注册表值全部写回原样" />
                <Button Grid.Column="2" Content="应用勾选的优化" Height="{StaticResource Size.ControlHeight}"
                        Padding="24,0" Margin="0,0,10,0" Style="{StaticResource Button.Accent}"
                        Click="ApplySelected_Click" x:Name="ApplyButton" />
                <Button Grid.Column="3" Content="关闭" Height="{StaticResource Size.ControlHeight}"
                        Padding="26,0" Click="Close_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
