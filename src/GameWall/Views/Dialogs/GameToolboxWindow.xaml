<Window x:Class="GameWall.Views.Dialogs.GameToolboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="游戏工具箱"
        Width="1120" Height="780"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        MinWidth="960" MinHeight="640">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- ═══════ 左侧分类栏的一项 ═══════ -->
        <DataTemplate x:Key="NavItemTemplate">
            <StackPanel>
                <!-- 分组之间的分隔线 -->
                <Border Height="1" Margin="14,6,14,5" Background="{DynamicResource Brush.BorderSoft}"
                        Visibility="{Binding ShowTopDivider, Converter={StaticResource BoolToVis}}" />

                <Grid Height="44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 选中时亮起的那根竖条 -->
                    <Border x:Name="NavBar" Grid.Column="0" Width="3" CornerRadius="2"
                            Background="Transparent" Margin="0,10" />

                    <TextBlock x:Name="NavGlyph" Grid.Column="1" Text="{Binding Glyph}" FontSize="14"
                               Margin="14,0,10,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextDim}" />

                    <TextBlock x:Name="NavTitle" Grid.Column="2" Text="{Binding Title}" FontSize="13"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.TextDim}" />

                    <Border x:Name="NavBadge" Grid.Column="3" CornerRadius="8" Padding="7,1" Margin="8,0,12,0"
                            VerticalAlignment="Center" Background="{DynamicResource Brush.SurfaceAlt}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                        <TextBlock x:Name="NavBadgeText" Text="{Binding BadgeText}" FontSize="10.5"
                                   Foreground="{DynamicResource Brush.TextFaint}" />
                    </Border>
                </Grid>
            </StackPanel>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="NavBar" Property="Background" Value="{DynamicResource Brush.Accent}" />
                    <Setter TargetName="NavTitle" Property="Foreground" Value="{DynamicResource Brush.Text}" />
                    <Setter TargetName="NavTitle" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="NavGlyph" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                    <Setter TargetName="NavBadge" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                    <Setter TargetName="NavBadge" Property="BorderBrush" Value="{DynamicResource Brush.AccentGlow}" />
                    <Setter TargetName="NavBadgeText" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ═══════ 一条优化项 ═══════ -->
        <DataTemplate x:Key="TweakItemTemplate">
            <Border x:Name="TweakCard" Margin="0,0,0,8" Padding="14,12" CornerRadius="12"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="0,2,12,0"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
                            <Border x:Name="RiskPill" CornerRadius="7" Padding="7,1" Margin="9,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.SurfaceAlt}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                <TextBlock x:Name="RiskLabel" Text="{Binding RiskText}" FontSize="10.5"
                                           Foreground="{DynamicResource Brush.TextFaint}" />
                            </Border>
                            <Border CornerRadius="7" Padding="7,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.SurfaceAlt}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                    Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding AdminBadge}" FontSize="10.5"
                                           Foreground="{DynamicResource Brush.Warning}" />
                            </Border>
                            <Border CornerRadius="7" Padding="7,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.AccentSoft}"
                                    BorderBrush="{DynamicResource Brush.AccentGlow}" BorderThickness="1"
                                    Visibility="{Binding IsApplied, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="已应用" FontSize="10.5"
                                           Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Summary}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                   LineHeight="19" Foreground="{DynamicResource Brush.TextDim}" />
                        <TextBlock Text="{Binding Effect}" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                   LineHeight="18" Foreground="{DynamicResource Brush.TextFaint}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="14,0,0,0">
                        <Button Content="撤销" Height="28" Padding="14,0" FontSize="11.5"
                                Style="{StaticResource Button.Base}"
                                Visibility="{Binding IsRevertVisible, Converter={StaticResource BoolToVis}}"
                                ToolTip="把这一项改回应用之前的取值"
                                Click="RevertOne_Click" Tag="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsHighRisk}" Value="True">
                    <Setter TargetName="RiskLabel" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsApplied}" Value="True">
                    <Setter TargetName="TweakCard" Property="BorderBrush" Value="{DynamicResource Brush.AccentGlow}" />
                    <Setter TargetName="TweakCard" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ═══════ 硬件分区里的一行 ═══════ -->
        <DataTemplate x:Key="HardwareRowTemplate">
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <!--
                        标签列用 SharedSizeGroup 让同一个分区里所有行共用一条对齐基线：
                        固定 112px 时，像「C:（本地磁盘 · Win11Pro X64）」「Generic PnP Monitor（主屏）」
                        这类长名字会被 CharacterEllipsis 直接截掉后半截。
                        改成 Auto + 共享宽度后按最长的那条撑开，标题仍然左对齐，长名字换行而不是被截。
                    -->
                    <ColumnDefinition Width="Auto" MinWidth="112" MaxWidth="260" SharedSizeGroup="HardwareLabel" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" FontSize="12" Margin="0,0,14,0"
                           Foreground="{DynamicResource Brush.TextDim}"
                           TextWrapping="Wrap" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5"
                           Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="2" Text="{Binding Hint}" FontSize="11" Margin="12,0,0,0"
                           Foreground="{DynamicResource Brush.TextFaint}"
                           Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DataTemplate>

        <!-- ═══════ 硬件分区卡片 ═══════ -->
        <DataTemplate x:Key="HardwareSectionTemplate">
            <Border Margin="0,0,0,12" Padding="18,15" CornerRadius="12"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1"
                    Grid.IsSharedSizeScope="True">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{Binding Glyph}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource HardwareRowTemplate}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ═══════ 硬件建议 ═══════ -->
        <DataTemplate x:Key="AdviceTemplate">
            <Border Margin="0,0,0,8" Padding="14,11" CornerRadius="10"
                    Background="{DynamicResource Brush.SurfaceAlt}"
                    BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Text="{Binding Detail}" FontSize="11.5" Margin="0,5,0,0" TextWrapping="Wrap"
                               LineHeight="18" Foreground="{DynamicResource Brush.TextDim}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ═══════ 一套电源方案 ═══════ -->
        <DataTemplate x:Key="PowerPlanTemplate">
            <Border x:Name="PlanCard" Margin="0,0,0,8" Padding="16,13" CornerRadius="12"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                            Background="{DynamicResource Brush.SurfaceAlt}" Margin="0,0,14,0">
                        <TextBlock Text="⚡" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Description}" FontSize="11" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextFaint}" />
                    </StackPanel>

                    <Border Grid.Column="2" CornerRadius="8" Padding="8,2" VerticalAlignment="Center"
                            Background="{DynamicResource Brush.AccentSoft}"
                            BorderBrush="{DynamicResource Brush.AccentGlow}" BorderThickness="1"
                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="当前使用" FontSize="10.5" Foreground="{DynamicResource Brush.Accent}" />
                    </Border>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="PlanCard" Property="BorderBrush" Value="{DynamicResource Brush.AccentGlow}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════ 标题栏 ═══════ -->
        <Border Grid.Row="0" Height="60" Background="{DynamicResource Brush.BarGradient}"
                BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid Margin="24,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🎛" FontSize="19" VerticalAlignment="Center" Margin="0,0,12,0" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="游戏工具箱" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text}" />
                        <Border CornerRadius="7" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <TextBlock Text="{Binding VersionText}" FontSize="10.5"
                                       Foreground="{DynamicResource Brush.TextFaint}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="本机硬件 · 游戏优化方案 · 电源方案，全部可还原"
                               FontSize="10.5" Margin="1,3,0,0"
                               Foreground="{DynamicResource Brush.TextFaint}" />
                </StackPanel>

                <Button Grid.Column="2" Content="✕" Style="{StaticResource Button.Icon}"
                        Click="Close_Click" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ═══════ 主体：左分类栏 + 右内容区 ═══════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── 左侧分类栏 ── -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="分类" Style="{StaticResource Text.Section}"
                               Margin="20,16,16,8" />

                    <ListBox x:Name="NavList" Grid.Row="1" ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                             ItemTemplate="{StaticResource NavItemTemplate}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Padding="0,0,0,8">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="9" Margin="8,1">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background"
                                                            Value="{DynamicResource Brush.CardHover}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bg" Property="Background"
                                                            Value="{DynamicResource Brush.SurfaceAlt}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- 权限状态贴在分类栏底部，不占内容区 -->
                    <Border Grid.Row="2" Margin="12,0,12,14" Padding="12,10" CornerRadius="10"
                            Background="{DynamicResource Brush.SurfaceAlt}"
                            BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1"
                            ToolTip="{Binding ElevationText}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0"
                                         Fill="{Binding ElevationBrush}" />
                                <TextBlock Text="{Binding ElevationShortText}" FontSize="11.5"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Text}" />
                            </StackPanel>
                            <TextBlock Text="{Binding ElevationHintText}" FontSize="10.5" Margin="0,5,0,0"
                                       TextWrapping="Wrap" LineHeight="15"
                                       Foreground="{DynamicResource Brush.TextFaint}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ── 右侧内容区 ── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 内容区页头：标题 + 副标题 + 本页工具按钮 -->
                <Border Grid.Row="0" Padding="24,16,24,12"
                        BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentTitle}" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Text}" />
                            <TextBlock Text="{Binding CurrentSubtitle}" FontSize="11" Margin="1,4,0,0"
                                       TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextFaint}" />
                        </StackPanel>

                        <!-- 硬件页的按钮 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding IsHardwarePage, Converter={StaticResource BoolToVis}}">
                            <Button Content="重新检测" Height="32" Padding="16,0" FontSize="11.5"
                                    Margin="0,0,8,0" Click="Refresh_Click"
                                    ToolTip="重新读取一遍硬件信息" />
                            <Button Content="导出报告" Height="32" Padding="16,0" FontSize="11.5"
                                    Click="Export_Click" ToolTip="导出为 TXT 或 JSON，存到桌面" />
                        </StackPanel>

                        <!-- 优化页的按钮 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding IsTweakPage, Converter={StaticResource BoolToVis}}">
                            <CheckBox x:Name="AppliedOnlyBox" Content="只看已应用" VerticalAlignment="Center"
                                      Margin="0,0,14,0"
                                      Checked="AppliedOnly_Changed" Unchecked="AppliedOnly_Changed" />
                            <Button Content="全选本类" Height="32" Padding="14,0" FontSize="11.5" Margin="0,0,8,0"
                                    Click="SelectAll_Click" ToolTip="勾选当前分类里还没应用的项" />
                            <Button Content="清空勾选" Height="32" Padding="14,0" FontSize="11.5"
                                    Click="ClearSelection_Click" />
                        </StackPanel>

                        <!-- 电源页的按钮 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding IsPowerPage, Converter={StaticResource BoolToVis}}">
                            <Button Content="卓越性能" Height="32" Padding="16,0" FontSize="11.5" Margin="0,0,8,0"
                                    Click="Ultimate_Click"
                                    ToolTip="Win10 1803 起内置但默认隐藏，找不到就自动复制一份" />
                            <Button Content="还原平衡" Height="32" Padding="16,0" FontSize="11.5"
                                    Click="Balanced_Click" ToolTip="切回系统默认的「平衡」方案" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══ 页面 1：硬件信息 ══ -->
                <ScrollViewer Grid.Row="1" Style="{StaticResource ScrollViewer.Clean}"
                              VerticalScrollBarVisibility="Auto" Padding="24,16,18,24"
                              Visibility="{Binding IsHardwarePage, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Sections}"
                                      ItemTemplate="{StaticResource HardwareSectionTemplate}" />

                        <TextBlock Text="针对这台机器的建议" Style="{StaticResource Text.Section}"
                                   Margin="2,4,0,10" />
                        <ItemsControl ItemsSource="{Binding Advices}"
                                      ItemTemplate="{StaticResource AdviceTemplate}" />
                        <TextBlock Text="以上只是根据硬件给出的提示，不会自动改任何设置。"
                                   FontSize="11" Margin="2,4,0,8" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.TextFaint}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ══ 页面 2：优化方案（按左栏分类切换） ══ -->
                <Grid Grid.Row="1" Visibility="{Binding IsTweakPage, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 搜索 + 预设 -->
                    <Grid Grid.Row="0" Margin="24,14,24,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" MaxWidth="320" HorizontalAlignment="Left">
                            <TextBox x:Name="SearchBox" Height="32" Padding="30,0,10,0"
                                     TextChanged="Search_Changed" ToolTip="按名称或说明过滤本类优化项" />
                            <TextBlock Text="🔍" FontSize="11.5" Margin="11,0,0,0"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource Brush.TextFaint}" />
                            <TextBlock Text="搜索本类优化项" FontSize="12" Margin="30,0,10,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{DynamicResource Brush.TextFaint}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="一键套用" Style="{StaticResource Text.Section}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Content="推荐" Height="30" Padding="14,0" FontSize="11.5" Margin="0,0,8,0"
                                    Tag="推荐" Click="Preset_Click"
                                    ToolTip="常用九项，覆盖游戏模式、优先级、输入延迟与独显" />
                            <Button Content="竞技" Height="30" Padding="14,0" FontSize="11.5" Margin="0,0,8,0"
                                    Tag="竞技（低延迟）" Click="Preset_Click"
                                    ToolTip="把输入延迟与网络响应压到最低" />
                            <Button Content="画质" Height="30" Padding="14,0" FontSize="11.5"
                                    Tag="画质（图形优化）" Click="Preset_Click"
                                    ToolTip="GPU 调度、HAGS、自动 HDR 与可变刷新率" />
                        </StackPanel>
                    </Grid>

                    <!-- 优化项列表 -->
                    <Grid Grid.Row="1" Margin="24,0,18,0">
                        <ListBox x:Name="TweakList"
                                 ItemsSource="{Binding FilteredTweaks}"
                                 ItemTemplate="{StaticResource TweakItemTemplate}"
                                 Background="Transparent" BorderThickness="0" Padding="0,0,6,16"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <!-- 本类无可显示项时的提示 -->
                        <Border Background="{DynamicResource Brush.Surface}" CornerRadius="12"
                                BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1"
                                Padding="28,26" VerticalAlignment="Top" Margin="0,0,6,0"
                                Visibility="{Binding IsTweakEmpty, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="这一类暂时没有可显示的优化项" FontSize="13"
                                           FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                                <TextBlock Text="{Binding TweakEmptyHint}" FontSize="11.5" Margin="0,7,0,0"
                                           TextWrapping="Wrap" LineHeight="18"
                                           Foreground="{DynamicResource Brush.TextFaint}" />
                                <Button Content="清空搜索与筛选" Height="30" Padding="16,0" FontSize="11.5"
                                        HorizontalAlignment="Left" Margin="0,14,0,0" Click="ResetFilter_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ══ 页面 3：电源方案 ══ -->
                <Grid Grid.Row="1" Visibility="{Binding IsPowerPage, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="24,14,24,12" Padding="16,12" CornerRadius="12"
                            Background="{DynamicResource Brush.SurfaceAlt}"
                            BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1">
                        <TextBlock Text="电源方案决定 CPU 会不会主动降频。玩游戏时选到「高性能」或「卓越性能」，空闲时会多耗一点电。切换只影响系统设置，随时可以切回「平衡」。"
                                   FontSize="11.5" TextWrapping="Wrap" LineHeight="18"
                                   Foreground="{DynamicResource Brush.TextDim}" />
                    </Border>

                    <Grid Grid.Row="1" Margin="24,0,18,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox x:Name="PowerList" Grid.Row="0"
                                 ItemsSource="{Binding PowerPlans}"
                                 ItemTemplate="{StaticResource PowerPlanTemplate}"
                                 SelectionChanged="PowerList_SelectionChanged"
                                 Background="Transparent" BorderThickness="0" Padding="0,0,6,8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,6,18">
                            <Button x:Name="ActivatePlanButton" Content="切换到这个方案" Height="34" Padding="20,0"
                                    FontSize="12" Style="{StaticResource Button.Accent}"
                                    IsEnabled="{Binding HasPlanSelection}"
                                    Click="ActivatePlan_Click" />
                            <TextBlock Text="{Binding PlanHintText}" FontSize="11" VerticalAlignment="Center"
                                       Margin="14,0,0,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Brush.TextFaint}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ═══════ 底部状态与操作条 ═══════ -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.BarGradient}"
                BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="0,1,0,0"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" FontSize="11.5"
                               Foreground="{DynamicResource Brush.TextDim}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="AppliedSummary" FontSize="11" Margin="0,4,0,0"
                               Foreground="{DynamicResource Brush.TextFaint}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button Grid.Column="1" Content="全部还原" Height="{StaticResource Size.ControlHeight}"
                        Padding="20,0" Margin="0,0,10,0" Click="RevertAll_Click"
                        ToolTip="把本工具改过的注册表值全部写回原样" />
                <Button Grid.Column="2" Content="应用勾选的优化" Height="{StaticResource Size.ControlHeight}"
                        Padding="24,0" Margin="0,0,10,0" Style="{StaticResource Button.Accent}"
                        Click="ApplySelected_Click" x:Name="ApplyButton" />
                <Button Grid.Column="3" Content="关闭" Height="{StaticResource Size.ControlHeight}"
                        Padding="26,0" Click="Close_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
