<Window x:Class="GameWall.Views.Dialogs.GameEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑游戏信息"
        Width="620" Height="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Style="{StaticResource Dialog.Card}" Margin="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="22,18,16,14">
                    <TextBlock Text="编辑游戏信息" Style="{StaticResource Text.Title}" FontSize="17" />
                    <Button Content="✕" Style="{StaticResource Button.Icon}" HorizontalAlignment="Right"
                            Click="Cancel_Click" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Style="{StaticResource ScrollViewer.Clean}" Padding="22,0,22,0">
                <StackPanel>
                    <!-- 封面预览 + 更换 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="150" Height="200" CornerRadius="10" ClipToBounds="True"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <Grid>
                                <Image x:Name="CoverPreview" Stretch="UniformToFill" />
                                <TextBlock x:Name="PlaceholderGlyph" Text="?" FontSize="52" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.TextFaint}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Top">
                            <TextBlock Text="封面" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="选择图片…" Click="PickCover_Click" Margin="0,0,8,0" />
                                <Button Content="用 exe 图标" Click="UseIcon_Click" Margin="0,0,8,0" />
                                <Button Content="清除" Click="ClearCover_Click" />
                            </StackPanel>
                            <TextBlock Text="建议使用竖版封面，比例 3:4（如 600×800）。"
                                       Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" Margin="0,10,0,0" />

                            <TextBlock Text="图标" Style="{StaticResource Text.Subtitle}" Margin="0,22,0,8" />
                            <Button Content="重新提取图标" Click="RefreshIcon_Click" HorizontalAlignment="Left" />
                            <TextBlock Text="从 exe 中提取的图标会缓存到本地，不会改动游戏文件。"
                                       Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,22" />

                    <!-- 基本信息 -->
                    <TextBlock Text="名称" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,7" />
                    <TextBox x:Name="NameBox" />

                    <TextBlock Text="可执行文件路径" Style="{StaticResource Text.Subtitle}" Margin="0,16,0,7" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PathBox" Grid.Column="0" IsReadOnly="True" />
                        <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Click="PickExe_Click" />
                    </Grid>

                    <TextBlock Text="存档目录（可选）" Style="{StaticResource Text.Subtitle}" Margin="0,16,0,7" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SaveBox" Grid.Column="0" />
                        <Button Grid.Column="1" Content="选择…" Margin="8,0,0,0" Click="PickSaveDir_Click" />
                    </Grid>

                    <TextBlock Text="标签（用逗号或空格分隔，例如：RPG, 单机, 通关中）"
                               Style="{StaticResource Text.Subtitle}" Margin="0,16,0,7" />
                    <TextBox x:Name="TagsBox" />

                    <TextBlock Text="备注" Style="{StaticResource Text.Subtitle}" Margin="0,16,0,7" />
                    <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap"
                             Height="74" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" />

                    <CheckBox x:Name="FavoriteBox" Content="加入收藏" Margin="0,18,0,6" />
                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮 -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                    Padding="22,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Click="Cancel_Click" Margin="0,0,10,0" Padding="20,8" />
                    <Button Content="保存" Style="{StaticResource Button.Accent}" Click="Save_Click" Padding="24,8" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
