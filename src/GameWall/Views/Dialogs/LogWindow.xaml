<Window x:Class="GameWall.Views.Dialogs.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GameWall.Converters"
        Title="运行日志" Width="980" Height="700"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="False"
        Background="{DynamicResource Brush.Window}"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 异常堆栈只在有内容时才显示，否则那段空白会把行高撑乱 -->
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Height="60" Background="{DynamicResource Brush.BarGradient}"
                BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid Margin="22,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="运行日志" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Text="扫描、启动、更新这些操作都记在这里，遇到问题可以复制发出来"
                               FontSize="12" Margin="1,6,0,0"
                               Foreground="{DynamicResource Brush.TextDim}" />
                </StackPanel>

                <Button Grid.Column="1" Content="✕" Width="36" Height="36"
                        Style="{StaticResource Button.Icon}"
                        Foreground="{DynamicResource Brush.Danger}"
                        Click="Close_Click" ToolTip="关闭" />
            </Grid>
        </Border>

        <!-- 工具条 -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="0,0,0,1"
                Padding="22,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ErrorOnlyBox" Content="只看错误"
                              VerticalAlignment="Center" Margin="0,0,18,0"
                              Checked="Filter_Changed" Unchecked="Filter_Changed" />
                    <TextBlock x:Name="CountText" VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource Brush.TextDim}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="复制全部" Height="32" Padding="16,0"
                            Margin="0,0,10,0"
                            Style="{StaticResource Button.Base}"
                            Click="Copy_Click" ToolTip="把当前显示的内容复制到剪贴板" />
                    <Button Content="导出为文本…" Height="32" Padding="16,0"
                            Margin="0,0,10,0"
                            Style="{StaticResource Button.Base}"
                            Click="Export_Click" ToolTip="存成 .txt，方便发给开发者" />
                    <Button Content="打开日志文件" Height="32" Padding="16,0"
                            Margin="0,0,10,0"
                            Style="{StaticResource Button.Base}"
                            Click="OpenFile_Click" ToolTip="打开 %AppData%\GameWall\gamewall.log" />
                    <Button Content="清空" Height="32" Padding="16,0"
                            Style="{StaticResource Button.Base}"
                            Click="Clear_Click" ToolTip="只清空窗口里的记录，日志文件保留" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 日志列表 -->
        <Grid Grid.Row="2">
            <ListBox x:Name="LogList"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="12,10"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="Margin" Value="0,0,0,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource Brush.CardHover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding TimeText}"
                                       FontFamily="Consolas, Microsoft YaHei UI"
                                       FontSize="12"
                                       VerticalAlignment="Top"
                                       Foreground="{DynamicResource Brush.TextFaint}" />

                            <Border Grid.Column="1" x:Name="LevelPill"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    CornerRadius="6" Padding="7,1" Margin="0,0,8,0"
                                    Background="{DynamicResource Brush.AccentSoft}">
                                <TextBlock x:Name="LevelLabel" Text="{Binding LevelText}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource Brush.Accent}" />
                            </Border>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Message}"
                                           FontSize="12.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.Text}" />
                                <TextBlock Text="{Binding Detail}"
                                           FontFamily="Consolas"
                                           FontSize="11" TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource Brush.TextDim}"
                                           Visibility="{Binding Detail, Converter={StaticResource StringToVis}, ConverterParameter=invert}" />
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter TargetName="LevelPill" Property="Background"
                                        Value="{DynamicResource Brush.DangerSoft}" />
                                <Setter TargetName="LevelLabel" Property="Foreground"
                                        Value="{DynamicResource Brush.Danger}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsWarn}" Value="True">
                                <Setter TargetName="LevelPill" Property="Background"
                                        Value="{DynamicResource Brush.WarningSoft}" />
                                <Setter TargetName="LevelLabel" Property="Foreground"
                                        Value="{DynamicResource Brush.Warning}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyHint"
                       Text="还没有任何记录。做点什么（扫描、添加游戏、检查更新），日志就会出现在这里。"
                       FontSize="13" TextWrapping="Wrap" MaxWidth="460"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" LineHeight="22"
                       Foreground="{DynamicResource Brush.TextDim}"
                       Visibility="Collapsed" />
        </Grid>

        <!-- 底部说明 -->
        <Border Grid.Row="3" Background="{DynamicResource Brush.BarGradient}"
                BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="0,1,0,0"
                Padding="22,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           FontSize="11.5" TextWrapping="Wrap" Margin="0,0,16,0"
                           Foreground="{DynamicResource Brush.TextDim}"
                           Text="日志只记录在本机，不会上传。文件位置：%AppData%\GameWall\gamewall.log（超过 512KB 自动轮转成 .old）" />

                <Button Grid.Column="1" Content="关闭" Height="36" Padding="22,0"
                        Style="{StaticResource Button.Accent}"
                        Click="Close_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
