<Window x:Class="GameWall.Views.Dialogs.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 GameWall"
        Width="620" Height="660"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Style="{StaticResource Dialog.Card}" Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ══════ 头图：品牌标识 + 名称 + 版本 ══════ -->
            <!-- 渐变整条用画刷资源：GradientStop.Color 塞 DynamicResource 会解析失败 -->
            <Border Grid.Row="0" CornerRadius="16,16,0,0" Height="168" ClipToBounds="True"
                    Background="{DynamicResource Brush.HeroGradient}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <!-- 右上角冷光 -->
                    <Ellipse Width="360" Height="360" HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-210,-90,0" Opacity="0.5" IsHitTestVisible="False"
                             Fill="{DynamicResource Brush.GlowSpot}" />

                    <Grid Margin="30,0,22,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0" Width="84" Height="84" Margin="0,0,22,0"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="pack://application:,,,/Assets/logo-256.png">
                            <Image.Effect>
                                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.8"
                                                  Color="{DynamicResource Color.Glow}" />
                            </Image.Effect>
                        </Image>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="GameWall" FontSize="27" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.HeroText}" />
                            <TextBlock x:Name="TaglineText" FontSize="12.5" Margin="1,7,0,0"
                                       Foreground="{DynamicResource Brush.HeroTextDim}" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Border CornerRadius="9" Padding="9,3"
                                        Background="{DynamicResource Brush.AccentSoft}"
                                        BorderBrush="{DynamicResource Brush.AccentGlow}"
                                        BorderThickness="1">
                                    <TextBlock x:Name="VersionBadge" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Accent}" />
                                </Border>
                                <Border CornerRadius="9" Padding="9,3" Margin="8,0,0,0"
                                        Background="#38000000" BorderBrush="{DynamicResource Brush.BorderSoft}"
                                        BorderThickness="1">
                                    <TextBlock x:Name="BuildBadge" FontSize="11.5"
                                               Foreground="{DynamicResource Brush.HeroTextDim}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="2" Content="✕" Style="{StaticResource Button.Icon}"
                                VerticalAlignment="Top" Margin="0,18,0,0" Click="Close_Click" />
                    </Grid>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Style="{StaticResource ScrollViewer.Clean}" Padding="30,24,30,0">
                <StackPanel>
                    <!-- ══════ 作者 ══════ -->
                    <TextBlock Text="作者" Style="{StaticResource Text.Section}" Margin="0,0,0,12" />

                    <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="12" Padding="18,16"
                            BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 头像位：渐变大写字母，跟应用图标同一套语言 -->
                            <!-- 注意：GradientStop.Color 只吃 Color，不能直接喂 Brush 资源，
                                 所以这里用现成的渐变画刷资源，而不是自己拼 LinearGradientBrush -->
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="16"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.AccentGradient}">
                                <TextBlock x:Name="AuthorGlyph" FontSize="24" FontWeight="Bold"
                                           Foreground="#04070D"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,12,0">
                                <TextBlock x:Name="AuthorNameText" FontSize="14.5" FontWeight="SemiBold" />
                                <TextBlock x:Name="AuthorHandleText" FontSize="11.5" Margin="0,5,0,0"
                                           Foreground="{DynamicResource Brush.TextDim}" />
                            </StackPanel>

                            <Button Grid.Column="2" Content="作者主页" Height="32" Padding="16,0"
                                    VerticalAlignment="Center" Click="OpenAuthor_Click" />
                        </Grid>
                    </Border>

                    <!-- ══════ 项目 ══════ -->
                    <TextBlock Text="项目" Style="{StaticResource Text.Section}" Margin="0,22,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="源码仓库" Height="{StaticResource Size.ControlHeight}"
                                Margin="0,0,5,0" Click="OpenHome_Click" />
                        <Button Grid.Column="1" Content="问题反馈" Height="{StaticResource Size.ControlHeight}"
                                Margin="5,0,0,0" Click="OpenIssues_Click" />
                    </Grid>
                    <Button Content="发布页面（Releases）" Height="{StaticResource Size.ControlHeight}"
                            Margin="0,10,0,0" Click="OpenReleases_Click" />

                    <!-- ══════ 更新 ══════ -->
                    <TextBlock Text="版本" Style="{StaticResource Text.Section}" Margin="0,22,0,12" />

                    <Border Background="{DynamicResource Brush.Surface}" CornerRadius="12" Padding="18,15"
                            BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" LineHeight="20" FontSize="12.5" />
                            <ProgressBar x:Name="UpdateProgress" Height="5" Margin="0,12,0,0"
                                         Visibility="Collapsed" Minimum="0" Maximum="1" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="CheckButton" Content="检查更新" Click="CheckUpdate_Click"
                                        Height="32" Padding="18,0" Margin="0,0,10,0" />
                                <Button x:Name="DownloadButton" Content="下载并重启" Click="Download_Click"
                                        Style="{StaticResource Button.Accent}"
                                        Height="32" Padding="20,0" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ══════ 许可证 / 致谢 ══════ -->
                    <TextBlock Text="许可证" Style="{StaticResource Text.Section}" Margin="0,22,0,12" />
                    <TextBlock x:Name="LicenseText" TextWrapping="Wrap" LineHeight="20" FontSize="12"
                               Foreground="{DynamicResource Brush.TextDim}" />

                    <TextBlock x:Name="CreditText" TextWrapping="Wrap" LineHeight="20" FontSize="12"
                               Foreground="{DynamicResource Brush.TextFaint}" Margin="0,14,0,4" />
                </StackPanel>
            </ScrollViewer>

            <!-- 底部操作条：两列，说明文字不会横向撑到按钮底下 -->
            <Border Grid.Row="2" Background="{DynamicResource Brush.BarGradient}"
                    BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="0,1,0,0"
                    Padding="30,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FooterText" Style="{StaticResource Text.Subtitle}"
                               VerticalAlignment="Center" Margin="0,0,16,0"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Content="关闭" Click="Close_Click"
                            Height="{StaticResource Size.ControlHeight}"
                            Padding="28,0" Style="{StaticResource Button.Accent}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
