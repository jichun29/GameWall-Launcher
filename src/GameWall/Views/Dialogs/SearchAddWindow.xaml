<Window x:Class="GameWall.Views.Dialogs.SearchAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="搜索添加游戏"
        Width="780" Height="660"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Style="{StaticResource Dialog.Card}" Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="26,22,18,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="搜索添加游戏" Style="{StaticResource Text.Title}" FontSize="18" />
                        <TextBlock Text="按名字在本地硬盘里找可执行文件" Style="{StaticResource Text.Dim}"
                                   FontSize="12" Margin="1,7,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕" Style="{StaticResource Button.Icon}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Click="Cancel_Click" />
                </Grid>
            </Border>

            <!-- 搜索行 -->
            <Grid Grid.Row="1" Margin="26,0,26,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Height="{StaticResource Size.ControlHeight}">
                    <TextBox x:Name="KeywordBox" KeyDown="KeywordBox_KeyDown" Padding="38,0,12,0" />
                    <TextBlock Text="🔎" FontSize="12" Margin="14,0,0,0"
                               VerticalAlignment="Center" HorizontalAlignment="Left"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource Brush.TextFaint}" />
                    <TextBlock Text="输入游戏名关键字，例如 Elden、赛博、Dishonored…"
                               Margin="38,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               TextTrimming="CharacterEllipsis" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Subtitle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=KeywordBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Button Grid.Column="1" Content="搜索" Style="{StaticResource Button.Accent}"
                        Margin="12,0,0,0" Height="{StaticResource Size.ControlHeight}"
                        Padding="30,0" Click="Search_Click" />
            </Grid>

            <Grid Grid.Row="2" Margin="26,0,26,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="StatusText" Grid.Row="0" Style="{StaticResource Text.Dim}"
                           FontSize="12" Margin="1,0,0,10"
                           Text="从下面这些目录里查找 exe 文件。" />

                <Border Grid.Row="1" CornerRadius="12" BorderThickness="1"
                        BorderBrush="{DynamicResource Brush.Border}"
                        Background="{DynamicResource Brush.Surface}"
                        ClipToBounds="True">
                    <ListBox x:Name="ResultList" Background="Transparent" BorderThickness="0"
                             Padding="6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="ResultList_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="14,11" />
                                <Setter Property="Margin" Value="0,0,0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="9"
                                                    Padding="{TemplateBinding Padding}"
                                                    BorderThickness="1" BorderBrush="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource Brush.CardHover}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource Brush.AccentSoft}" />
                                                    <Setter TargetName="Bd" Property="BorderBrush"
                                                            Value="{DynamicResource Brush.CardBorderHover}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding SuggestedName}" FontWeight="SemiBold"
                                                   FontSize="13.5"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding FilePath}" Style="{StaticResource Text.Subtitle}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}"
                                               Style="{StaticResource Text.Dim}" FontSize="11"
                                               VerticalAlignment="Center" Margin="16,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- 底部：提示文字与按钮分列，文案再长也不会钻到按钮下面 -->
            <Border Grid.Row="3" Background="{DynamicResource Brush.BarGradient}"
                    BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="0,1,0,0"
                    Padding="26,16" Margin="0,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HintText" Grid.Column="0" Style="{StaticResource Text.Subtitle}"
                               VerticalAlignment="Center" Margin="0,0,18,0"
                               TextTrimming="CharacterEllipsis"
                               Text="双击结果直接添加，或选中后点「添加选中」。" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="取消" Click="Cancel_Click" Margin="0,0,12,0"
                                Height="{StaticResource Size.ControlHeight}" Padding="22,0" />
                        <Button Content="添加选中" Style="{StaticResource Button.Accent}"
                                Click="Add_Click" Height="{StaticResource Size.ControlHeight}" Padding="26,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
