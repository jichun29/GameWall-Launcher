<Window x:Class="GameWall.Views.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="760" Height="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Style="{StaticResource Dialog.Card}" Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="26,22,18,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="设置" Style="{StaticResource Text.Title}" FontSize="18"
                               Margin="0,0,16,0" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="✕" Style="{StaticResource Button.Icon}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Click="Cancel_Click" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Style="{StaticResource ScrollViewer.Clean}" Padding="26,0,26,0">
                <StackPanel>

                    <!-- ══════ 外观 ══════ -->
                    <TextBlock Text="外观" Style="{StaticResource Text.Title}" FontSize="15" Margin="0,0,0,14" />

                    <TextBlock Text="主题" Style="{StaticResource Text.Section}" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="DarkRadio" Content="深色" GroupName="Theme" Margin="0,0,22,0"
                                     VerticalAlignment="Center" Checked="Theme_Checked" />
                        <RadioButton x:Name="LightRadio" Content="浅色" GroupName="Theme" Margin="0,0,22,0"
                                     VerticalAlignment="Center" Checked="Theme_Checked" />
                        <RadioButton x:Name="SystemRadio" Content="跟随系统" GroupName="Theme"
                                     VerticalAlignment="Center" Checked="Theme_Checked" />
                    </StackPanel>
                    <TextBlock x:Name="SystemThemeHint" Style="{StaticResource Text.Dim}" FontSize="11.5"
                               Margin="0,10,0,0" TextWrapping="Wrap" />

                    <TextBlock Text="强调色" Style="{StaticResource Text.Section}" Margin="0,22,0,10" />
                    <StackPanel Orientation="Horizontal" Height="34">
                        <Button x:Name="AccentSwatch" Content="" Width="52" Height="30" Padding="0"
                                VerticalAlignment="Center"
                                Click="PickAccent_Click" ToolTip="点击选择强调色" />
                        <TextBlock x:Name="AccentText" Style="{StaticResource Text.Subtitle}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                        <Button Content="跟随主题" Margin="16,0,0,0" Height="30" Padding="14,0"
                                VerticalAlignment="Center" Click="ResetAccent_Click"
                                ToolTip="恢复成当前主题自带的强调色" />
                    </StackPanel>

                    <TextBlock Text="卡片宽度" Style="{StaticResource Text.Section}" Margin="0,22,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="CardWidthSlider" Grid.Column="0" Minimum="110" Maximum="260"
                                TickFrequency="5" IsSnapToTickEnabled="True"
                                ValueChanged="CardWidth_Changed" VerticalAlignment="Center" />
                        <TextBlock x:Name="CardWidthText" Grid.Column="1" Style="{StaticResource Text.Subtitle}"
                                   VerticalAlignment="Center" Margin="14,0,0,0" MinWidth="60" />
                    </Grid>

                    <CheckBox x:Name="ShowLabelsBox" Content="在卡片上显示游戏名称" Margin="0,20,0,0" />
                    <CheckBox x:Name="CardAnimationsBox" Content="卡片悬停放大与选中呼吸光效" Margin="0,14,0,0" />
                    <TextBlock Style="{StaticResource Text.Dim}" FontSize="11.5" TextWrapping="Wrap"
                               Margin="28,6,0,0"
                               Text="关掉之后卡片只做最简单的描边变化，低配机器或远程桌面里更顺滑。" />

                    <TextBlock Text="背景" Style="{StaticResource Text.Section}" Margin="0,22,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BackgroundPathBox" Grid.Column="0" IsReadOnly="True"
                                 Height="{StaticResource Size.ControlHeight}" />
                        <Button Grid.Column="1" Content="选择图片…" Margin="10,0,0,0"
                                Height="{StaticResource Size.ControlHeight}" Padding="18,0"
                                Click="PickBackground_Click" />
                        <Button Grid.Column="2" Content="清除" Margin="10,0,0,0"
                                Height="{StaticResource Size.ControlHeight}" Padding="18,0"
                                Click="ClearBackground_Click" />
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="背景不透明度" Style="{StaticResource Text.Subtitle}"
                                   VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Slider x:Name="BgOpacitySlider" Grid.Column="1" Minimum="0" Maximum="1"
                                TickFrequency="0.05" IsSnapToTickEnabled="True"
                                ValueChanged="BgOpacity_Changed" VerticalAlignment="Center" />
                        <TextBlock x:Name="BgOpacityText" Grid.Column="2" Style="{StaticResource Text.Subtitle}"
                                   VerticalAlignment="Center" Margin="14,0,0,0" MinWidth="50" />
                    </Grid>

                    <Grid Margin="0,16,0,0" Height="34">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="背景色" Style="{StaticResource Text.Subtitle}"
                                   VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Button x:Name="BgColorSwatch" Grid.Column="1" Content="" Width="52" Height="30"
                                Padding="0" VerticalAlignment="Center"
                                Click="PickBackgroundColor_Click" ToolTip="点击选择背景色" />
                        <TextBlock x:Name="BgColorText" Grid.Column="2" Style="{StaticResource Text.Subtitle}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                        <Button Grid.Column="3" Content="跟随主题" Margin="16,0,0,0" Height="30" Padding="14,0"
                                VerticalAlignment="Center" Click="ResetBackgroundColor_Click"
                                ToolTip="让背景色跟着深浅色主题走" />
                    </Grid>

                    <Border Style="{StaticResource Accent.Divider}" Margin="0,26,0,22" />

                    <!-- ══════ 窗口与行为 ══════ -->
                    <TextBlock Text="窗口与行为" Style="{StaticResource Text.Title}" FontSize="15" Margin="0,0,0,14" />

                    <CheckBox x:Name="TopmostBox" Content="窗口置顶，不被其它窗口遮挡" Margin="0,0,0,14" />
                    <CheckBox x:Name="FullscreenBox" Content="启动时全屏最大化" Margin="0,0,0,14" />
                    <CheckBox x:Name="TrayBox" Content="关闭窗口时最小化到系统托盘（不退出）" Margin="0,0,0,14" />
                    <CheckBox x:Name="AutoStartBox" Content="开机自动启动（启动后静默进托盘）" Margin="0,0,0,14" />
                    <CheckBox x:Name="ConfirmRemoveBox" Content="移除游戏前弹出确认" Margin="0,0,0,14" />
                    <CheckBox x:Name="MinimizeOnLaunchBox" Content="启动游戏后自动最小化 GameWall" />

                    <Border Style="{StaticResource Accent.Divider}" Margin="0,26,0,22" />

                    <!-- ══════ 桌面整理 ══════ -->
                    <TextBlock Text="桌面整理" Style="{StaticResource Text.Title}" FontSize="15" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" Margin="0,0,0,14"
                               Text="游戏都收进游戏墙之后，桌面上的快捷方式就可以挪走了。挪走的文件放在备份目录里，不会删除。" />

                    <CheckBox x:Name="AskTidyBox" Content="扫描 / 导入之后询问是否整理桌面" Margin="0,0,0,14" />
                    <CheckBox x:Name="TidyHintBox" Content="在顶栏提示「桌面还能再干净一点」" Margin="0,0,0,16" />

                    <TextBlock x:Name="TidyBackupText" Style="{StaticResource Text.Subtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="立即整理桌面…" Click="OpenTidy_Click" Margin="0,0,10,0" />
                        <Button x:Name="RestoreShortcutsButton" Content="还原到桌面"
                                Click="RestoreShortcuts_Click" Margin="0,0,10,0" />
                        <Button Content="打开备份目录" Click="OpenBackupDir_Click" />
                    </StackPanel>

                    <Border Style="{StaticResource Accent.Divider}" Margin="0,26,0,22" />

                    <!-- ══════ 扫描 ══════ -->
                    <TextBlock Text="扫描目录" Style="{StaticResource Text.Title}" FontSize="15" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" Margin="0,0,0,14"
                               Text="「扫描」和「搜索添加」会遍历这些目录。目录越少扫得越快。" />

                    <Border CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                            Background="{DynamicResource Brush.Surface}" Height="164" ClipToBounds="True">
                        <Grid>
                            <ListBox x:Name="PathList" Background="Transparent" BorderThickness="0" Padding="6">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="12,9" />
                                        <Setter Property="Margin" Value="0,0,0,2" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background"
                                                                    Value="{DynamicResource Brush.CardHover}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background"
                                                                    Value="{DynamicResource Brush.AccentSoft}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock x:Name="NoPathHint" Style="{StaticResource Text.Subtitle}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="还没有扫描目录，点右下角「添加目录」" />
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0" HorizontalAlignment="Right">
                        <Button Content="添加目录…" Click="AddPath_Click" Margin="0,0,10,0" />
                        <Button Content="移除选中" Click="RemovePath_Click" Margin="0,0,10,0" />
                        <Button Content="恢复默认目录" Click="ResetPaths_Click" />
                    </StackPanel>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="搜索深度" Style="{StaticResource Text.Subtitle}"
                                   VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Slider x:Name="DepthSlider" Grid.Column="1" Minimum="1" Maximum="8"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="Depth_Changed" VerticalAlignment="Center" />
                        <TextBlock x:Name="DepthText" Grid.Column="2" Style="{StaticResource Text.Subtitle}"
                                   VerticalAlignment="Center" Margin="14,0,0,0" MinWidth="60" />
                    </Grid>

                    <Border Style="{StaticResource Accent.Divider}" Margin="0,26,0,22" />

                    <!-- ══════ 更新 ══════ -->
                    <TextBlock Text="更新" Style="{StaticResource Text.Title}" FontSize="15" Margin="0,0,0,10" />
                    <TextBlock x:Name="UpdateHintText" Style="{StaticResource Text.Subtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,14" />
                    <CheckBox x:Name="AutoCheckUpdateBox" Content="启动时自动检查新版本（每天最多一次）"
                              Margin="0,0,0,16" />

                    <TextBlock Text="下载源" Style="{StaticResource Text.Section}" Margin="0,0,0,10" />
                    <ComboBox x:Name="UpdateSourceBox" Width="300" HorizontalAlignment="Left"
                              Height="{StaticResource Size.ControlHeight}" />
                    <TextBlock Style="{StaticResource Text.Dim}" FontSize="11.5" TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Text="国内直连 GitHub 有时会很慢。「自动」会挨个试，哪个先通就用哪个。" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="CheckUpdateButton" Content="立即检查更新"
                                Click="CheckUpdate_Click" Margin="0,0,10,0" />
                        <Button Content="打开 Releases 页面" Click="OpenReleases_Click" />
                    </StackPanel>

                    <Border Style="{StaticResource Accent.Divider}" Margin="0,26,0,22" />

                    <!-- ══════ 数据与关于 ══════ -->
                    <TextBlock Text="数据与关于" Style="{StaticResource Text.Title}" FontSize="15" Margin="0,0,0,10" />
                    <TextBlock x:Name="DataPathText" Style="{StaticResource Text.Subtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,14" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="打开数据目录" Click="OpenDataDir_Click" Margin="0,0,10,0" />
                        <Button Content="关于 GameWall" Click="OpenAbout_Click" Margin="0,0,10,0" />
                        <Button Content="恢复默认设置" Click="ResetAll_Click" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" LineHeight="20"
                               Margin="0,20,0,4"
                               Text="GameWall 是纯本地工具：所有数据都保存在上面的目录里，不会上传到任何服务器。检查更新只读取 GitHub 上的公开版本号。" />
                </StackPanel>
            </ScrollViewer>

            <!-- 底部操作条：显式给不透明背景，避免滚动内容滚到底时从按钮背后透出来 -->
            <Border Grid.Row="2" Background="{DynamicResource Brush.BarGradient}"
                    BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="0,1,0,0"
                    Padding="26,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Click="Cancel_Click" Margin="0,0,12,0"
                            Height="{StaticResource Size.ControlHeight}" Padding="24,0" />
                    <Button Content="保存" Style="{StaticResource Button.Accent}" Click="Save_Click"
                            Height="{StaticResource Size.ControlHeight}" Padding="32,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
