<Window x:Class="GameWall.Views.Dialogs.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="从平台导入"
        Width="720" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <Border Style="{StaticResource Dialog.Card}" Margin="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="22,18,16,10">
                    <TextBlock Text="从游戏平台导入" Style="{StaticResource Text.Title}" FontSize="17" />
                    <Button Content="✕" Style="{StaticResource Button.Icon}" HorizontalAlignment="Right"
                            Click="Cancel_Click" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="22,0,22,12">
                <TextBlock Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap"
                           Text="读取本机 Steam / Epic / GOG 的已安装列表。只会读取安装目录和游戏名，不会登录你的账号，也不会联网。" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="全选" Click="SelectAll_Click" Margin="0,0,8,0" />
                    <Button Content="全不选" Click="SelectNone_Click" Margin="0,0,8,0" />
                    <Button Content="重新扫描" Click="Rescan_Click" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="2" Margin="22,0,22,0" CornerRadius="10" BorderThickness="1"
                    BorderBrush="{DynamicResource Brush.Border}"
                    Background="{DynamicResource Brush.Surface}">
                <Grid>
                    <ListBox x:Name="GameList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,12,0" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding SuggestedName}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding InstallDir}" Style="{StaticResource Text.Subtitle}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                    </StackPanel>

                                    <Border Grid.Column="2" Style="{StaticResource Tag.Pill}"
                                            VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding Platform}" FontSize="11" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyHint" Style="{StaticResource Text.Subtitle}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                               Text="没有在本机找到 Steam / Epic / GOG 的游戏。&#10;如果平台装在非默认位置，可以先用「扫描」或「手动添加」。" />
                </Grid>
            </Border>

            <Border Grid.Row="3" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                    Padding="22,14" Margin="0,16,0,0">
                <Grid>
                    <TextBlock x:Name="CountText" Style="{StaticResource Text.Subtitle}"
                               VerticalAlignment="Center" Text="已选中 0 个" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Click="Cancel_Click" Margin="0,0,10,0" Padding="20,8" />
                        <Button Content="导入选中" Style="{StaticResource Button.Accent}"
                                Click="Import_Click" Padding="24,8" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
