<Window x:Class="GameWall.Views.Dialogs.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="从平台导入"
        Width="740" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Style="{StaticResource Dialog.Card}" Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="26,22,18,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="从游戏平台导入" Style="{StaticResource Text.Title}" FontSize="18" />
                        <TextBlock Text="Steam / Epic / GOG 已安装列表" Style="{StaticResource Text.Dim}"
                                   FontSize="12" Margin="1,7,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕" Style="{StaticResource Button.Icon}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Click="Cancel_Click" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="26,0,26,16">
                <TextBlock Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" LineHeight="20"
                           Text="读取本机 Steam / Epic / GOG 的已安装列表。只会读取安装目录和游戏名，不会登录你的账号，也不会联网。" />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="全选" Click="SelectAll_Click" Margin="0,0,10,0" />
                    <Button Content="全不选" Click="SelectNone_Click" Margin="0,0,10,0" />
                    <Button Content="重新扫描" Click="Rescan_Click" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="2" Margin="26,0,26,0" CornerRadius="12" BorderThickness="1"
                    BorderBrush="{DynamicResource Brush.Border}"
                    Background="{DynamicResource Brush.Surface}"
                    ClipToBounds="True">
                <Grid>
                    <ListBox x:Name="GameList" Background="Transparent" BorderThickness="0" Padding="6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="14,10" />
                                <Setter Property="Margin" Value="0,0,0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="9"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource Brush.CardHover}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,14,0" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding SuggestedName}" FontWeight="SemiBold"
                                                   FontSize="13.5"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding InstallDir}" Style="{StaticResource Text.Subtitle}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                                    </StackPanel>

                                    <Border Grid.Column="2" Style="{StaticResource Tag.Pill}"
                                            VerticalAlignment="Center" Margin="14,0,0,0">
                                        <TextBlock Text="{Binding Platform}" FontSize="10.5" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyHint" Style="{StaticResource Text.Subtitle}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440" LineHeight="21"
                               Text="没有在本机找到 Steam / Epic / GOG 的游戏。&#10;如果平台装在非默认位置，可以先用「扫描」或「手动添加」。" />
                </Grid>
            </Border>

            <Border Grid.Row="3" Background="{DynamicResource Brush.BarGradient}"
                    BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="0,1,0,0"
                    Padding="26,16" Margin="0,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CountText" Grid.Column="0" Style="{StaticResource Text.Subtitle}"
                               VerticalAlignment="Center" Margin="0,0,18,0"
                               TextTrimming="CharacterEllipsis" Text="已选中 0 个" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="取消" Click="Cancel_Click" Margin="0,0,12,0"
                                Height="{StaticResource Size.ControlHeight}" Padding="22,0" />
                        <Button Content="导入选中" Style="{StaticResource Button.Accent}"
                                Click="Import_Click" Height="{StaticResource Size.ControlHeight}" Padding="26,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
