<Window x:Class="GameWall.Views.Dialogs.RelinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修复失效的游戏路径"
        Width="820" Height="660"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Style="{StaticResource Dialog.Card}" Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="26,22,18,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="修复失效的游戏路径" Style="{StaticResource Text.Title}" FontSize="18" />
                        <TextBlock Text="换电脑 / 挪了游戏目录之后，重新指向新的 exe" Style="{StaticResource Text.Dim}"
                                   FontSize="12" Margin="1,7,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕" Style="{StaticResource Button.Icon}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Click="Cancel_Click" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="26,0,26,14">
                <TextBlock x:Name="IntroText" Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" LineHeight="20" />

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="按目录批量修复…" Click="BatchRelink_Click" Margin="0,0,10,0"
                            ToolTip="整个游戏目录搬了家？指定新的根目录，程序会按文件名把剩下的都对上" />
                    <Button Content="全选可修复的" Click="SelectAll_Click" Margin="0,0,10,0" />
                    <Button Content="全不选" Click="SelectNone_Click" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="2" Margin="26,0,26,0" CornerRadius="12" BorderThickness="1"
                    BorderBrush="{DynamicResource Brush.Border}"
                    Background="{DynamicResource Brush.Surface}"
                    ClipToBounds="True">
                <Grid>
                    <ListBox x:Name="BrokenList" Background="Transparent" BorderThickness="0" Padding="6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="14,11" />
                                <Setter Property="Margin" Value="0,0,0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="9"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource Brush.CardHover}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding HasGuess}"
                                              VerticalAlignment="Center" Margin="0,0,14,0" />

                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                            <Border Style="{StaticResource Tag.Pill}" Margin="9,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ConfidenceText}" FontSize="10" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding OldPath}" Style="{StaticResource Text.Dim}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />

                                        <TextBlock Text="{Binding GuessPath}" FontSize="11" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Success}"
                                                   Visibility="{Binding HasGuess, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="14,0,0,0">
                                        <Button Content="指定…" Height="30" Padding="14,0" FontSize="11.5"
                                                Click="PickForItem_Click" Tag="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyHint" Style="{StaticResource Text.Subtitle}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" LineHeight="21"
                               Visibility="Collapsed"
                               Text="没有失效的路径。&#10;游戏被移动或删除后，这里可以一键重新指向。" />

                    <!-- 扫描遮罩：猜新位置要遍历磁盘，慢盘上可能好几秒。
                         不遮住的话用户看到的是一个空列表，以为卡死了。
                         扫描在后台线程跑，这块遮罩只负责给个「正在找」的反馈。 -->
                    <Border x:Name="BusyPanel" Background="{DynamicResource Brush.Surface}"
                            Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="正在磁盘上找这些游戏…" FontSize="13"
                                       Foreground="{DynamicResource Brush.TextDim}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="盘大的话要几秒，找到就会列出来"
                                       FontSize="11" Foreground="{DynamicResource Brush.TextFaint}"
                                       Margin="0,7,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="3" Background="{DynamicResource Brush.BarGradient}"
                    BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="0,1,0,0"
                    Padding="26,16" Margin="0,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CountText" Grid.Column="0" Style="{StaticResource Text.Subtitle}"
                               VerticalAlignment="Center" Margin="0,0,18,0"
                               TextTrimming="CharacterEllipsis" Text="已选中 0 项" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="取消" Click="Cancel_Click" Margin="0,0,12,0"
                                Height="{StaticResource Size.ControlHeight}" Padding="22,0" />
                        <Button Content="应用修复" Style="{StaticResource Button.Accent}"
                                Click="Apply_Click" Height="{StaticResource Size.ControlHeight}" Padding="26,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
