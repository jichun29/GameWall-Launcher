<Window x:Class="GameWall.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:GameWall.Converters"
        xmlns:vm="clr-namespace:GameWall.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="GameWall"
        Width="1280" Height="820"
        MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        AllowDrop="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:PathToImageConverter x:Key="PathToImage" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <conv:FavoriteMenuTextConverter x:Key="FavoriteMenuText" />

        <!-- 视图切换按钮：选中态跟随 ViewMode -->
        <Style x:Key="Segment.Wall" TargetType="Button" BasedOn="{StaticResource Button.Segment}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWallMode}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Segment.List" TargetType="Button" BasedOn="{StaticResource Button.Segment}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsListMode}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Segment.Compact" TargetType="Button" BasedOn="{StaticResource Button.Segment}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompactMode}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ═══════════ 卡片右键菜单 ═══════════ -->
        <ContextMenu x:Key="CardMenu" x:Shared="False">
            <MenuItem Header="启动游戏" Icon="▶" InputGestureText="双击" Command="{Binding LaunchCommand}" />
            <MenuItem Header="编辑信息…" Icon="✎" Command="{Binding EditCommand}" />
            <Separator />
            <MenuItem Header="打开安装目录" Icon="📁" Command="{Binding RevealCommand}" />
            <MenuItem Header="打开存档目录" Icon="💾" Command="{Binding OpenSaveDirCommand}" />
            <Separator />
            <MenuItem Header="{Binding IsFavorite, Converter={StaticResource FavoriteMenuText}}"
                      Icon="★" Command="{Binding ToggleFavoriteCommand}" />
            <MenuItem Header="从游戏墙移除" Icon="✕" Command="{Binding RemoveCommand}" />
        </ContextMenu>

        <!-- ═══════════ 标签胶囊模板 ═══════════ -->
        <DataTemplate x:Key="TagTemplate">
            <Border Style="{StaticResource Tag.Pill}">
                <TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource Brush.Accent}" />
            </Border>
        </DataTemplate>

        <!-- ═══════════ 卡片：大图墙模式（默认） ═══════════ -->
        <DataTemplate x:Key="Card.Wall" DataType="{x:Type vm:GameCardViewModel}">
            <Grid x:Name="CardRoot"
                  Margin="8"
                  Cursor="Hand"
                  Background="Transparent"
                  ToolTip="{Binding Tooltip}"
                  ContextMenu="{StaticResource CardMenu}"
                  Width="{Binding DataContext.Settings.CardWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                  MouseLeftButtonDown="Card_MouseLeftButtonDown"
                  MouseMove="Card_MouseMove"
                  MouseLeave="Card_MouseLeave"
                  DragOver="Card_DragOver"
                  Drop="Card_Drop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="CoverBorder"
                        Grid.Row="0"
                        CornerRadius="12"
                        ClipToBounds="True"
                        Background="{DynamicResource Brush.Card}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="4"
                                          Color="{DynamicResource Color.Shadow}"
                                          Opacity="{DynamicResource Double.ShadowOpacity}" />
                    </Border.Effect>

                    <Grid>
                        <!-- 3:4 封面区域 -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="4*" />
                                <RowDefinition Height="5*" />
                            </Grid.RowDefinitions>
                            <Rectangle Grid.RowSpan="2" Fill="{DynamicResource Brush.SurfaceAlt}" />
                            <Image Grid.RowSpan="2"
                                   Source="{Binding PrimaryImage, Converter={StaticResource PathToImage}}"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Grid.RowSpan="2"
                                       Text="{Binding InitialGlyph}"
                                       FontSize="64"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.TextFaint}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding UsesPlaceholder, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <!-- 底部渐变遮罩 + 文字 -->
                        <Rectangle Fill="{DynamicResource Brush.CardOverlay}" VerticalAlignment="Bottom" Height="130" />

                        <!-- 左上角角标 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                            <Border Background="#CC000000" CornerRadius="8" Padding="6,2" Margin="0,0,5,0"
                                    Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="★" FontSize="11" Foreground="#FFFFC53D" />
                            </Border>
                            <Border Background="#CCB3261E" CornerRadius="8" Padding="6,2"
                                    Visibility="{Binding IsMissing, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="文件缺失" FontSize="10" Foreground="White" />
                            </Border>
                        </StackPanel>

                        <!-- 名称 / 副标题 -->
                        <StackPanel VerticalAlignment="Bottom" Margin="12,0,12,10">
                            <TextBlock Text="{Binding Name}"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding DataContext.Settings.ShowLabels, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Subtitle}"
                                       Foreground="#B3FFFFFF"
                                       FontSize="11"
                                       Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding DataContext.Settings.ShowLabels, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <!-- 悬停播放按钮 -->
                        <Border x:Name="PlayOverlay" Background="{DynamicResource Brush.CoverScrim}" Opacity="0" CornerRadius="12">
                            <Border Width="54" Height="54"
                                    CornerRadius="27"
                                    Background="{DynamicResource Brush.Accent}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Path Data="M 0 0 L 18 10 L 0 20 Z"
                                      Fill="White"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="4,0,0,0" />
                            </Border>
                        </Border>
                    </Grid>
                </Border>

                <!-- 悬停显示标签 -->
                <ItemsControl x:Name="TagRow" Grid.Row="1" ItemsSource="{Binding Tags}"
                              ItemTemplate="{StaticResource TagTemplate}"
                              Margin="2,7,2,0" Opacity="0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="CoverBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                    <Setter TargetName="CoverBorder" Property="BorderThickness" Value="2" />
                </DataTrigger>
                <Trigger SourceName="CoverBorder" Property="IsMouseOver" Value="True">
                    <Setter TargetName="PlayOverlay" Property="Opacity" Value="1" />
                    <Setter TargetName="TagRow" Property="Opacity" Value="1" />
                    <Setter TargetName="CoverBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ═══════════ 卡片：紧凑模式 ═══════════ -->
        <DataTemplate x:Key="Card.Compact" DataType="{x:Type vm:GameCardViewModel}">
            <Border Width="132" Height="170" Margin="6" CornerRadius="10"
                    Background="{DynamicResource Brush.Card}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    Cursor="Hand"
                    ToolTip="{Binding Tooltip}"
                    ContextMenu="{StaticResource CardMenu}"
                    AllowDrop="True"
                    MouseLeftButtonDown="Card_MouseLeftButtonDown"
                    MouseMove="Card_MouseMove"
                    DragOver="Card_DragOver"
                    Drop="Card_Drop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="10,10,0,0" ClipToBounds="True">
                        <Grid>
                            <Rectangle Fill="{DynamicResource Brush.SurfaceAlt}" />
                            <Image Source="{Binding PrimaryImage, Converter={StaticResource PathToImage}}"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="{Binding InitialGlyph}"
                                       FontSize="34" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.TextFaint}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding UsesPlaceholder, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="1"
                               Text="{Binding Name}"
                               Margin="8,6,8,8"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.Text}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ═══════════ 卡片：列表模式 ═══════════ -->
        <DataTemplate x:Key="Card.List" DataType="{x:Type vm:GameCardViewModel}">
            <Border Margin="0,0,0,6"
                    Padding="10"
                    CornerRadius="10"
                    Background="{DynamicResource Brush.Card}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    Cursor="Hand"
                    ToolTip="{Binding Tooltip}"
                    ContextMenu="{StaticResource CardMenu}"
                    AllowDrop="True"
                    MouseLeftButtonDown="Card_MouseLeftButtonDown"
                    MouseMove="Card_MouseMove"
                    DragOver="Card_DragOver"
                    Drop="Card_Drop">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="56" CornerRadius="6" ClipToBounds="True"
                            Background="{DynamicResource Brush.SurfaceAlt}">
                        <Grid>
                            <Image Source="{Binding PrimaryImage, Converter={StaticResource PathToImage}}" Stretch="UniformToFill" />
                            <TextBlock Text="{Binding InitialGlyph}" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.TextFaint}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding UsesPlaceholder, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ExecutablePath}" FontSize="11"
                                   Foreground="{DynamicResource Brush.TextFaint}"
                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                    </StackPanel>

                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Tags}" VerticalAlignment="Center"
                                  Margin="10,0" ItemTemplate="{StaticResource TagTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock Grid.Column="3" Text="{Binding Subtitle}" FontSize="11"
                               Foreground="{DynamicResource Brush.TextDim}"
                               VerticalAlignment="Center" Margin="10,0,16,0" />

                    <Button Grid.Column="4" Style="{StaticResource Button.Accent}"
                            Content="启动" Padding="16,6" VerticalAlignment="Center"
                            Command="{Binding LaunchCommand}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- ═════════ 背景层：主题底色 → 自定义纯色 → 自定义图片 → 主题遮罩 ═════════ -->
        <Rectangle Fill="{DynamicResource Brush.Window}" />
        <Rectangle Fill="{Binding Settings.BackgroundColor, Converter={StaticResource HexToBrush}}" />
        <Image Source="{Binding Settings.BackgroundImagePath, Converter={StaticResource PathToImage}}"
               Stretch="UniformToFill"
               Opacity="{Binding Settings.BackgroundImageOpacity}" />
        <!-- 遮罩只在确实设了背景图时才画，否则纯色/主题底色会被冲淡 -->
        <Rectangle Fill="{DynamicResource Brush.WindowBackdrop}" Opacity="0.86"
                   Visibility="{Binding Settings.BackgroundImagePath, Converter={StaticResource StringToVis}}" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═════════ 顶栏：品牌 + 筛选 + 窗口按钮 ═════════ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="60" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 品牌 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Brush.Accent}">
                            <TextBlock Text="G" FontSize="16" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="GameWall" Style="{StaticResource Text.Title}" FontSize="16"
                                   VerticalAlignment="Center" Margin="10,0,16,0" />
                    </StackPanel>

                    <!-- 搜索框：放在 * 列里，窗口变窄时它先收缩，绝不挤走右边的按钮 -->
                    <Grid Grid.Column="1" MaxWidth="280" Height="34" HorizontalAlignment="Left"
                          VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                                 Style="{StaticResource TextBox.Base}"
                                 Height="34"
                                 Padding="30,0,8,0"
                                 KeyDown="SearchBox_KeyDown" />
                        <TextBlock Text="🔍" FontSize="12" Margin="11,0,0,0"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource Brush.TextFaint}" />
                        <TextBlock Text="搜索游戏名 / 标签…"
                                   Margin="30,0,10,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Brush.TextFaint}"
                                   Visibility="{Binding SearchText, Converter={StaticResource StringToVis}, ConverterParameter=invert}" />
                    </Grid>

                    <!-- 标签筛选 -->
                    <ComboBox Grid.Column="2" Width="126" Height="34" Margin="0,0,10,0" VerticalAlignment="Center"
                              ItemsSource="{Binding TagOptions}"
                              SelectedItem="{Binding SelectedTag, Mode=TwoWay}"
                              ToolTip="按标签筛选" />

                    <CheckBox Grid.Column="3" Content="收藏" Margin="0,0,12,0" VerticalAlignment="Center"
                              IsChecked="{Binding FavoritesOnly, Mode=TwoWay}"
                              ToolTip="只显示已收藏的游戏" />

                    <!-- 窗口按钮：永远贴右，且不参与收缩 -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PinButton" Content="📌" ToolTip="窗口置顶" Margin="0,0,4,0"
                                Style="{StaticResource Button.Icon}" Click="PinButton_Click" />
                        <Button Content="─" ToolTip="最小化" Style="{StaticResource Button.Icon}" Click="Minimize_Click" />
                        <Button Content="□" ToolTip="最大化 / 还原" Style="{StaticResource Button.Icon}" Click="Maximize_Click" />
                        <Button Content="✕" ToolTip="关闭到托盘" Style="{StaticResource Button.Icon}"
                                Foreground="{DynamicResource Brush.Danger}" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═════════ 工具栏：操作按钮 + 视图切换 ═════════ -->
            <Border Grid.Row="1"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="16,0,16,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 操作按钮：空间不够时自动换行，不会顶出窗口 -->
                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="＋ 添加游戏" Style="{StaticResource Button.Accent}"
                                Command="{Binding AddGameCommand}" Margin="0,0,8,0"
                                ToolTip="选择一个 .exe 或快捷方式加进游戏墙" />
                        <Button Content="🔎 搜索添加" Command="{Binding SearchAddCommand}" Margin="0,0,8,0"
                                ToolTip="按名字在本地硬盘里找 exe" />
                        <Button Content="⟳ 扫描" Command="{Binding ScanCommand}" Margin="0,0,8,0"
                                ToolTip="扫描已配置的游戏目录" />
                        <Button Content="⤓ 平台导入" Command="{Binding ImportCommand}"
                                ToolTip="从 Steam / Epic / GOG 读取已安装游戏" />
                    </WrapPanel>

                    <!-- 视图切换 + 设置：固定贴右 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="10,0,0,0">
                        <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="2"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="▦" ToolTip="大图墙" Width="32"
                                        Style="{StaticResource Segment.Wall}"
                                        Command="{Binding SetViewModeCommand}" CommandParameter="Wall" />
                                <Button Content="☰" ToolTip="列表模式" Width="32"
                                        Style="{StaticResource Segment.List}"
                                        Command="{Binding SetViewModeCommand}" CommandParameter="List" />
                                <Button Content="▤" ToolTip="紧凑模式" Width="32"
                                        Style="{StaticResource Segment.Compact}"
                                        Command="{Binding SetViewModeCommand}" CommandParameter="Compact" />
                            </StackPanel>
                        </Border>

                        <Button Content="⚙ 设置" ToolTip="设置" Style="{StaticResource Button.Segment}"
                                Command="{Binding SettingsCommand}" Padding="12,5" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═════════ 主内容区 ═════════ -->
            <Grid Grid.Row="2">
                <!-- 大图墙 -->
                <ScrollViewer Style="{StaticResource ScrollViewer.Clean}"
                              Visibility="{Binding IsWallMode, Converter={StaticResource BoolToVis}}"
                              Padding="14,14,14,24">
                    <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource Card.Wall}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 列表模式 -->
                <ScrollViewer Style="{StaticResource ScrollViewer.Clean}"
                              Visibility="{Binding IsListMode, Converter={StaticResource BoolToVis}}"
                              Padding="16,14,16,24">
                    <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource Card.List}" />
                </ScrollViewer>

                <!-- 紧凑模式 -->
                <ScrollViewer Style="{StaticResource ScrollViewer.Clean}"
                              Visibility="{Binding IsCompactMode, Converter={StaticResource BoolToVis}}"
                              Padding="14,14,14,24">
                    <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource Card.Compact}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 空状态：一个游戏都没有 -->
                <Border Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource Brush.Scrim}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                        <TextBlock Text="🎮" FontSize="60" HorizontalAlignment="Center" />
                        <TextBlock Text="游戏墙还是空的" Style="{StaticResource Text.Title}"
                                   HorizontalAlignment="Center" Margin="0,16,0,8" />
                        <TextBlock Text="把散落在桌面上的游戏收进来，用封面墙的方式一眼找到它们。"
                                   Style="{StaticResource Text.Dim}" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,0,0,22" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="＋ 手动添加游戏" Style="{StaticResource Button.Accent}"
                                    Command="{Binding AddGameCommand}" Margin="0,0,10,0" Padding="18,9" />
                            <Button Content="⟳ 自动扫描" Command="{Binding ScanCommand}" Padding="18,9" Margin="0,0,10,0" />
                            <Button Content="⤓ 从平台导入" Command="{Binding ImportCommand}" Padding="18,9" />
                        </StackPanel>

                        <TextBlock Text="提示：也可以把 .exe 或快捷方式直接拖进这个窗口。"
                                   Style="{StaticResource Text.Subtitle}"
                                   HorizontalAlignment="Center" Margin="0,20,0,0" />
                    </StackPanel>
                </Border>

                <!-- 空状态：筛选无结果 -->
                <Border Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource Brush.Scrim}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="没有匹配的游戏" Style="{StaticResource Text.Title}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="试试清空搜索关键词，或把标签切回「全部」。"
                                   Style="{StaticResource Text.Dim}" HorizontalAlignment="Center" Margin="0,9,0,18" />
                        <Button Content="清空筛选" Command="{Binding ClearFiltersCommand}"
                                HorizontalAlignment="Center" Padding="18,8" />
                    </StackPanel>
                </Border>

                <!-- 忙碌遮罩 -->
                <Border Background="{DynamicResource Brush.ScrimStrong}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                        <ProgressBar IsIndeterminate="True" Width="200" Height="3"
                                     Foreground="{DynamicResource Brush.Accent}"
                                     Background="Transparent" BorderThickness="0" />
                        <TextBlock Text="{Binding BusyText}" Style="{StaticResource Text.Dim}"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═════════ 状态栏 ═════════ -->
            <Border Grid.Row="3"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,1,0,0" Padding="16,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Subtitle}">
                            <Run Text="共 " />
                            <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=" 个游戏" />
                        </TextBlock>
                        <TextBlock Text="·" Style="{StaticResource Text.Subtitle}" Margin="8,0" />
                        <TextBlock Style="{StaticResource Text.Subtitle}">
                            <Run Text="当前显示 " />
                            <Run Text="{Binding VisibleCount, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Subtitle}"
                               Text="双击启动 · 拖拽排序 · Ctrl+V 粘贴添加 · 右键更多操作" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
