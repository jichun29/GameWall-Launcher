<Window x:Class="GameWall.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:GameWall.Converters"
        xmlns:vm="clr-namespace:GameWall.ViewModels"
        xmlns:ctl="clr-namespace:GameWall.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="GameWall"
        Width="1280" Height="820"
        MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        AllowDrop="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:PathToImageConverter x:Key="PathToImage" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <conv:FavoriteMenuTextConverter x:Key="FavoriteMenuText" />
        <conv:RoundedClipConverter x:Key="RoundedClip" />

        <!-- ═══════════ 视图切换按钮 ═══════════ -->

        <Style x:Key="Segment.Card" TargetType="Button" BasedOn="{StaticResource Button.Segment}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCardMode}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Segment.List" TargetType="Button" BasedOn="{StaticResource Button.Segment}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsListMode}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ═══════════ 工具栏上的次级按钮 ═══════════
             统一 38 高、内边距 16,0，悬停时才浮出发光 -->
        <Style x:Key="Button.Tool" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Height" Value="{StaticResource Size.ControlHeight}" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <!-- ═══════════ 卡片右键菜单 ═══════════ -->
        <ContextMenu x:Key="CardMenu" x:Shared="False">
            <MenuItem Header="启动游戏" Icon="▶" InputGestureText="双击" Command="{Binding LaunchCommand}" />
            <MenuItem Header="编辑信息…" Icon="✎" Command="{Binding EditCommand}" />
            <Separator />
            <MenuItem Header="打开安装目录" Icon="📁" Command="{Binding RevealCommand}" />
            <MenuItem Header="打开存档目录" Icon="💾" Command="{Binding OpenSaveDirCommand}" />
            <Separator />
            <MenuItem Header="{Binding IsFavorite, Converter={StaticResource FavoriteMenuText}}"
                      Icon="★" Command="{Binding ToggleFavoriteCommand}" />
            <MenuItem Header="从游戏墙移除" Icon="✕" Command="{Binding RemoveCommand}" />
        </ContextMenu>

        <!-- ═══════════ 标签胶囊模板 ═══════════ -->
        <DataTemplate x:Key="TagTemplate">
            <Border Style="{StaticResource Tag.Pill}">
                <TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource Brush.Accent}" />
            </Border>
        </DataTemplate>

        <!-- ═══════════ 卡片：卡片式（默认，像 Steam 游戏库） ═══════════
             动效设计：
              · 悬停：整卡放大到 1.032 倍 + 外发光亮起 + 播放键回弹浮出 + 标签滑入
              · 选中：霓虹描边 + 独立的 SelectGlow 呼吸（1.6 秒一轮）
              · 悬停发光和选中发光是两个不同的 Border，动画互不覆盖；
                放在同一个元素上会打架——悬停结束时把发光拉到 0，
                选中的呼吸就跟着灭了
              · 动画都挂在 DataTrigger 的 EnterActions / ExitActions 上，
                虚拟化回收容器时 WPF 会自动撤掉，不会留在后台空转 -->
        <DataTemplate x:Key="Card.Tile" DataType="{x:Type vm:GameCardViewModel}">
            <Grid x:Name="CardRoot"
                  Margin="10"
                  Cursor="Hand"
                  Background="Transparent"
                  ToolTip="{Binding Tooltip}"
                  ContextMenu="{StaticResource CardMenu}"
                  Width="{Binding DataContext.Settings.CardWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                  MouseLeftButtonDown="Card_MouseLeftButtonDown"
                  MouseMove="Card_MouseMove"
                  MouseLeave="Card_MouseLeave"
                  DragOver="Card_DragOver"
                  Drop="Card_Drop">
                <!-- 放大动画的支点放在正中央，看起来像卡片朝用户抬起来 -->
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
                </Grid.RenderTransform>
                <Grid.RenderTransformOrigin>
                    <Point X="0.5" Y="0.5" />
                </Grid.RenderTransformOrigin>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <!-- 选中呼吸光：只在选中时活过来 -->
                    <Border x:Name="SelectGlow"
                            CornerRadius="20"
                            Background="{DynamicResource Brush.AccentGlow}"
                            Opacity="0"
                            Margin="-7">
                        <Border.Effect>
                            <BlurEffect Radius="30" />
                        </Border.Effect>
                    </Border>

                    <!-- 悬停光：鼠标移上去才亮 -->
                    <Border x:Name="HoverGlow"
                            CornerRadius="18"
                            Background="{DynamicResource Brush.AccentGlow}"
                            Opacity="0"
                            Margin="-4">
                        <Border.Effect>
                            <BlurEffect Radius="20" />
                        </Border.Effect>
                    </Border>

                    <Border x:Name="CoverBorder"
                            CornerRadius="14"
                            ClipToBounds="True"
                            Background="{DynamicResource Brush.Card}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="13" ShadowDepth="4" Direction="270"
                                              Color="{DynamicResource Color.Shadow}"
                                              Opacity="{DynamicResource Double.ShadowOpacity}" />
                        </Border.Effect>

                        <Grid>
                            <!-- 关键：Border.CornerRadius 只画自己那条描边，不裁子元素；
                                 ClipToBounds 裁的是矩形。所以封面图、渐变遮罩这些方形内容
                                 会把四个角的圆弧盖住 —— 平时看不出来，一旦选中描边变成
                                 2px 电光青，就只剩四条直边，像直角边框。
                                 这里按圆角把整层内容裁一遍，圆弧才真的露出来。 -->
                            <Grid.Clip>
                                <MultiBinding Converter="{StaticResource RoundedClip}">
                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                    <Binding Source="13" />
                                </MultiBinding>
                            </Grid.Clip>
                            <!-- 封面是 2:3 的竖版比例（高 = 宽 × 3/2），高度取 CardHeight
                                 而不是 CardWidth —— 正方形会把 Steam 那张 600×900 的封面
                                 上下裁掉一大截。这里必须用固定高度，不能用星号行：
                                 虚拟化面板按内容量高时星号行会塌掉，
                                 有封面的卡片和没封面的卡片就会高矮不一。 -->
                            <Grid Height="{Binding DataContext.Settings.CardHeight, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Rectangle Fill="{DynamicResource Brush.SurfaceAlt}" />
                                <Rectangle Fill="{Binding PlaceholderBrush}" />
                                <!-- 只有用户自己指定的封面才满铺；exe 图标是 32×32 的小图，
                                     拉满会糊成一团黑影，所以下面单独当徽标居中摆。 -->
                                <Image Source="{Binding PrimaryImage, Converter={StaticResource PathToImage}}"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
                                <!-- 徽标与首字要往上偏一点：名称和副标题压在封面底部，
                                     正中间摆会和文字撞在一起（审计脚本会报 OVERLAP）。 -->
                                <Border Width="64" Height="64" CornerRadius="16"
                                        Background="#26FFFFFF"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Margin="0,0,0,34"
                                        Visibility="{Binding ShowIcon, Converter={StaticResource BoolToVis}}">
                                    <Image Source="{Binding IconImage, Converter={StaticResource PathToImage}}"
                                           Width="46" Height="46"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <!-- 既没封面也没图标时的占位：做成「字母标牌」而不是一个游离的字母。
                                     单个老大字母在渐变底上看着像渲染出错，加个描边框
                                     就像杂志封面上的刊头字，整墙看过去也统一。 -->
                                <Border Width="104" Height="104" CornerRadius="22"
                                        Background="#1AFFFFFF"
                                        BorderBrush="#3DFFFFFF"
                                        BorderThickness="1.5"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Margin="0,0,0,34"
                                        Visibility="{Binding UsesPlaceholder, Converter={StaticResource BoolToVis}}">
                                    <!-- 用 Viewbox 兜住字数：占位字可能是两个汉字（「英雄」）
                                         或三个字母（"ITT"），字号写死会溢出，这里按方框等比缩放 -->
                                    <Viewbox Margin="14" Stretch="Uniform">
                                        <TextBlock Text="{Binding InitialGlyph}"
                                                   FontSize="54"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   Opacity="0.9"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Viewbox>
                                </Border>
                            </Grid>

                            <!-- 底部渐变遮罩 + 文字。只在有真实封面时才压暗，
                                 否则会把居中摆的图标徽标和占位渐变一起糊掉。
                                 竖版封面高 225 时，108 的遮罩刚好盖住「名称 + 副标题」这一带。 -->
                            <Rectangle x:Name="CardOverlayRect" Fill="{DynamicResource Brush.CardOverlay}"
                                       VerticalAlignment="Bottom" Height="108"
                                       Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />

                            <!-- 左上角角标 -->
                            <StackPanel x:Name="BadgeRow" Orientation="Horizontal"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                                <Border Background="#CC000000" CornerRadius="9" Padding="7,3" Margin="0,0,6,0"
                                        Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="★" FontSize="11" Foreground="#FFFFC53D" />
                                </Border>
                                <Border Background="#CCB3261E" CornerRadius="9" Padding="7,3"
                                        Visibility="{Binding IsMissing, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="文件缺失" FontSize="10" Foreground="White" />
                                </Border>
                            </StackPanel>

                            <!-- 名称 / 副标题：左右留 12，底部留 12，不再贴着封面边线 -->
                            <StackPanel VerticalAlignment="Bottom" Margin="12,0,12,12">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="White"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           TextOptions.TextFormattingMode="Ideal"
                                           Visibility="{Binding DataContext.Settings.ShowLabels, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding Subtitle}"
                                           Foreground="#B8FFFFFF"
                                           FontSize="10.5"
                                           Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding DataContext.Settings.ShowLabels, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <!-- 悬停播放按钮 -->
                            <Border x:Name="PlayOverlay" Background="{DynamicResource Brush.CoverScrim}"
                                    Opacity="0" CornerRadius="14">
                                <Border x:Name="PlayCircle" Width="50" Height="50"
                                        CornerRadius="25"
                                        Background="{DynamicResource Brush.AccentGradient}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="PlayScale" ScaleX="0.82" ScaleY="0.82" />
                                    </Border.RenderTransform>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.85"
                                                          Color="{DynamicResource Color.Glow}" />
                                    </Border.Effect>
                                    <Path Data="M 0 0 L 13 7.5 L 0 15 Z"
                                          Fill="#04070D"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="5,0,0,0" />
                                </Border>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 悬停显示标签 -->
                <ItemsControl x:Name="TagRow" Grid.Row="1" ItemsSource="{Binding Tags}"
                              ItemTemplate="{StaticResource TagTemplate}"
                              Margin="4,11,4,0" Opacity="0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>

            <DataTemplate.Triggers>
                <!-- ── 悬停：描边、遮罩、标签这些「状态」变化始终生效 ── -->
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=CardRoot}" Value="True">
                    <Setter TargetName="CardRoot" Property="Panel.ZIndex" Value="20" />
                    <Setter TargetName="CoverBorder" Property="BorderBrush" Value="{DynamicResource Brush.CardBorderHover}" />
                    <Setter TargetName="PlayOverlay" Property="Opacity" Value="1" />
                    <Setter TargetName="TagRow" Property="Opacity" Value="1" />
                </DataTrigger>

                <!-- ── 悬停动画（放大 + 发光 + 播放键回弹）：可以在设置里关掉 ── -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, ElementName=CardRoot}" Value="True" />
                        <Condition Binding="{Binding DataContext.Settings.EnableCardAnimations, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="CardScale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 To="1.032" Duration="0:0:0.16">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="CardScale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 To="1.032" Duration="0:0:0.16">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="HoverGlow"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0.9" Duration="0:0:0.18" />
                                <DoubleAnimation Storyboard.TargetName="PlayScale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 To="1" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase Amplitude="0.5" EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="PlayScale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 To="1" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase Amplitude="0.5" EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="CardScale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 To="1" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="CardScale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 To="1" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="HoverGlow"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.25" />
                                <DoubleAnimation Storyboard.TargetName="PlayScale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 To="0.82" Duration="0:0:0.15" />
                                <DoubleAnimation Storyboard.TargetName="PlayScale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 To="0.82" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>

                <!-- ── 选中：霓虹描边始终生效 ── -->
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="CoverBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                    <Setter TargetName="CoverBorder" Property="BorderThickness" Value="2" />
                    <Setter TargetName="CardRoot" Property="Panel.ZIndex" Value="10" />
                </DataTrigger>

                <!-- ── 选中呼吸光：同样受动画开关控制 ── -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="True" />
                        <Condition Binding="{Binding DataContext.Settings.EnableCardAnimations, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard x:Name="SelectPulse">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="SelectGlow"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="0.40" To="0.95" Duration="0:0:0.85"
                                                 AutoReverse="True" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="SelectGlow"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.3" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>

                <!-- 关掉「显示游戏名称」后，底部那块渐变遮罩也没意义了，
                     留着只会平白压暗一条封面 -->
                <DataTrigger Binding="{Binding DataContext.Settings.ShowLabels, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                    <Setter TargetName="CardOverlayRect" Property="Height" Value="0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ═══════════ 卡片：列表模式 ═══════════ -->
        <DataTemplate x:Key="Card.List" DataType="{x:Type vm:GameCardViewModel}">
            <Grid x:Name="RowHolder" Margin="0,0,0,8" Background="Transparent"
                  MouseLeftButtonDown="Card_MouseLeftButtonDown"
                  MouseMove="Card_MouseMove"
                  MouseLeave="Card_MouseLeave"
                  DragOver="Card_DragOver"
                  Drop="Card_Drop">
                <!-- 悬停时整行右移 6px 并轻微放大：列表模式空间窄，
                     用位移代替发光更不容易糊成一团 -->
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="RowShift" X="0" />
                </Grid.RenderTransform>

            <Border x:Name="RowRoot"
                    Padding="14,12"
                    CornerRadius="12"
                    Background="{DynamicResource Brush.Card}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    Cursor="Hand"
                    ToolTip="{Binding Tooltip}"
                    ContextMenu="{StaticResource CardMenu}"
                    AllowDrop="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 缩略图也用 2:3（54×81），和卡片式的竖版封面保持同一比例 -->
                    <Border Grid.Column="0" Width="54" Height="81" CornerRadius="9" ClipToBounds="True"
                            Background="{DynamicResource Brush.SurfaceAlt}">
                        <Grid>
                            <Rectangle Fill="{Binding PlaceholderBrush}" />
                            <Image Source="{Binding PrimaryImage, Converter={StaticResource PathToImage}}"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
                            <!-- 列表里缩略图只有 54×81，图标按原样等比摆进去，不拉伸 -->
                            <Image Source="{Binding IconImage, Converter={StaticResource PathToImage}}"
                                   Width="36" Height="36"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ShowIcon, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding InitialGlyph}" FontSize="20" FontWeight="Bold"
                                       Foreground="White" Opacity="0.88"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding UsesPlaceholder, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ExecutablePath}" FontSize="11"
                                   Foreground="{DynamicResource Brush.TextFaint}"
                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                    </StackPanel>

                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Tags}" VerticalAlignment="Center"
                                  Margin="14,0" ItemTemplate="{StaticResource TagTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock Grid.Column="3" Text="{Binding Subtitle}" FontSize="11"
                               Foreground="{DynamicResource Brush.TextDim}"
                               VerticalAlignment="Center" Margin="14,0,20,0" />

                    <Button Grid.Column="4" Style="{StaticResource Button.Accent}"
                            Content="启动" Padding="22,0" Height="34" VerticalAlignment="Center"
                            Command="{Binding LaunchCommand}" />
                </Grid>
            </Border>
            </Grid>

            <DataTemplate.Triggers>
                <Trigger SourceName="RowRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="RowRoot" Property="Background" Value="{DynamicResource Brush.CardHover}" />
                    <Setter TargetName="RowRoot" Property="BorderBrush" Value="{DynamicResource Brush.CardBorderHover}" />
                </Trigger>
                <!-- 悬停：整行右移，贴边感消失（可在设置里关掉动画） -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, ElementName=RowHolder}" Value="True" />
                        <Condition Binding="{Binding DataContext.Settings.EnableCardAnimations, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="RowShift"
                                                 Storyboard.TargetProperty="X"
                                                 To="6" Duration="0:0:0.16">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="RowShift"
                                                 Storyboard.TargetProperty="X"
                                                 To="0" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
                <!-- 选中：霓虹描边 + 底色提亮 -->
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="RowRoot" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                    <Setter TargetName="RowRoot" Property="BorderThickness" Value="2" />
                    <Setter TargetName="RowRoot" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- ═════════ 背景层：主题底色 → 右上冷光 → 自定义纯色 → 自定义图片 → 主题遮罩 ═════════ -->
        <Rectangle Fill="{DynamicResource Brush.Window}" />
        <Rectangle Fill="{DynamicResource Brush.PageGlow}" />
        <Rectangle Fill="{Binding Settings.BackgroundColor, Converter={StaticResource HexToBrush}}" />
        <Image Source="{Binding Settings.BackgroundImagePath, Converter={StaticResource PathToImage}}"
               Stretch="UniformToFill"
               Opacity="{Binding Settings.BackgroundImageOpacity}" />
        <!-- 遮罩只在确实设了背景图时才画，否则纯色/主题底色会被冲淡 -->
        <Rectangle Fill="{DynamicResource Brush.WindowBackdrop}" Opacity="0.86"
                   Visibility="{Binding Settings.BackgroundImagePath, Converter={StaticResource StringToVis}}" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <!-- 提示条区（新版本 / 桌面可整理），两条都隐藏时 Auto 行自动收成 0 -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═════════ 顶栏：品牌 + 筛选 + 窗口按钮 ═════════ -->
            <Grid Grid.Row="0">
                <Border Background="{DynamicResource Brush.BarGradient}"
                        BorderBrush="{DynamicResource Brush.BorderSoft}"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="20,0,16,0" Height="64">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="60" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 品牌 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                            <!-- 应用图标直接引用打包的 PNG，和 exe / 托盘图标同一套设计 -->
                            <Image Width="34" Height="34" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Source="pack://application:,,,/Assets/logo-256.png"
                                   ToolTip="GameWall">
                                <Image.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="0"
                                                      Opacity="0.55"
                                                      Color="{DynamicResource Color.Glow}" />
                                </Image.Effect>
                            </Image>
                            <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="GameWall" FontSize="17" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.AccentGradient}"
                                               TextOptions.TextFormattingMode="Ideal" />
                                    <!-- 版本号常驻标题右边。没新版时是个低调的小胶囊；
                                         有新版时变成可点的「NEW · vX.Y.Z」，点一下直接进更新页。 -->
                                    <Border x:Name="VersionPill" Margin="8,1,0,0"
                                            CornerRadius="6" Padding="6,1"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource Brush.SurfaceAlt}"
                                            BorderBrush="{DynamicResource Brush.BorderSoft}"
                                            BorderThickness="1"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="VersionPill_Click"
                                            ToolTip="当前版本 · 点一下查看更新">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="VersionText" FontSize="10"
                                                       Foreground="{DynamicResource Brush.TextDim}"
                                                       Text="{Binding VersionText}" />
                                            <Border x:Name="NewBadge" Margin="5,0,0,0" CornerRadius="4"
                                                    Padding="4,0" VerticalAlignment="Center"
                                                    Background="{DynamicResource Brush.Accent}"
                                                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="NEW" FontSize="9" FontWeight="Bold"
                                                           Foreground="#04070D" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <!-- 副标题要和主标题拉开行距，不能用负 Margin 硬挤，否则会压住字形下沿 -->
                                <TextBlock Text="游戏墙 · 本地游戏库" FontSize="10"
                                           Foreground="{DynamicResource Brush.TextFaint}"
                                           Margin="1,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 搜索框：放在 * 列里，窗口变窄时它先收缩，绝不挤走右边的按钮 -->
                        <Grid Grid.Column="1" MaxWidth="300" Height="{StaticResource Size.ControlHeight}"
                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBox x:Name="SearchBox"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                                     Style="{StaticResource TextBox.Base}"
                                     Height="{StaticResource Size.ControlHeight}"
                                     Padding="34,0,10,0"
                                     KeyDown="SearchBox_KeyDown" />
                            <TextBlock Text="🔍" FontSize="12" Margin="13,0,0,0"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource Brush.TextFaint}" />
                            <TextBlock Text="搜索游戏名 / 标签…"
                                       Margin="34,0,12,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Brush.TextFaint}"
                                       Visibility="{Binding SearchText, Converter={StaticResource StringToVis}, ConverterParameter=invert}" />
                        </Grid>

                        <!-- 标签筛选 -->
                        <ComboBox Grid.Column="2" Width="136" Height="{StaticResource Size.ControlHeight}"
                                  Margin="0,0,14,0" VerticalAlignment="Center"
                                  ItemsSource="{Binding TagOptions}"
                                  SelectedItem="{Binding SelectedTag, Mode=TwoWay}"
                                  ToolTip="按标签筛选" />

                        <CheckBox Grid.Column="3" Content="收藏" Margin="0,0,16,0" VerticalAlignment="Center"
                                  IsChecked="{Binding FavoritesOnly, Mode=TwoWay}"
                                  ToolTip="只显示已收藏的游戏" />

                        <!-- 窗口按钮：永远贴右，且不参与收缩 -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="PinButton" Content="📌" ToolTip="窗口置顶" Margin="0,0,4,0"
                                    Style="{StaticResource Button.Icon}" Click="PinButton_Click" />
                            <Button Content="─" ToolTip="最小化" Style="{StaticResource Button.Icon}" Click="Minimize_Click" />
                            <Button Content="□" ToolTip="最大化 / 还原" Style="{StaticResource Button.Icon}" Click="Maximize_Click" />
                            <Button Content="✕" ToolTip="关闭到托盘" Style="{StaticResource Button.Icon}"
                                    Foreground="{DynamicResource Brush.Danger}" Click="Close_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 顶栏下沿的霓虹细线 -->
                <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Brush.AccentLine}" />
            </Grid>

            <!-- ═════════ 工具栏：操作按钮 + 视图切换 ═════════ -->
            <Border Grid.Row="1"
                    Background="{DynamicResource Brush.BarGradient}"
                    BorderBrush="{DynamicResource Brush.BorderSoft}"
                    BorderThickness="0,0,0,1"
                    Padding="20,12,20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 操作按钮：空间不够时自动换行，不会顶出窗口
                         统一 38 高，与标题栏的搜索框/窗口按钮保持同一基线 -->
                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="＋ 添加游戏" Style="{StaticResource Button.Accent}"
                                Height="{StaticResource Size.ControlHeight}" Padding="20,0" Margin="0,0,10,0"
                                Command="{Binding AddGameCommand}"
                                ToolTip="选择一个 .exe 或快捷方式加进游戏墙" />
                        <Button Content="🔎 搜索添加" Style="{StaticResource Button.Tool}"
                                Command="{Binding SearchAddCommand}"
                                ToolTip="按名字在本地硬盘里找 exe" />
                        <Button Content="⟳ 扫描" Style="{StaticResource Button.Tool}"
                                Command="{Binding ScanCommand}"
                                ToolTip="扫描已配置的游戏目录" />
                        <Button Content="⤓ 平台导入" Style="{StaticResource Button.Tool}"
                                Command="{Binding ImportCommand}"
                                ToolTip="从 Steam / Epic / GOG 读取已安装游戏" />
                        <Button Content="🧹 整理桌面" Style="{StaticResource Button.Tool}"
                                Command="{Binding TidyDesktopCommand}"
                                ToolTip="把已经收进游戏墙的游戏快捷方式从桌面挪走（可还原）" />
                        <Button Content="🎛 工具箱" Style="{StaticResource Button.Tool}"
                                Command="{Binding ToolboxCommand}"
                                ToolTip="本机硬件一览、游戏优化方案、电源方案（全部可还原）" />
                    </WrapPanel>

                    <!-- 视图切换 + 设置：固定贴右。外框总高同样收在 38 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="11" Padding="3"
                                Margin="0,0,10,0" Height="{StaticResource Size.ControlHeight}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="▤" ToolTip="卡片式（默认，像 Steam 游戏库）" Width="38" Height="30"
                                        Style="{StaticResource Segment.Card}"
                                        Command="{Binding SetViewModeCommand}" CommandParameter="Card" />
                                <Button Content="☰" ToolTip="列表式" Width="38" Height="30"
                                        Style="{StaticResource Segment.List}"
                                        Command="{Binding SetViewModeCommand}" CommandParameter="List" />
                            </StackPanel>
                        </Border>

                        <Button Content="ⓘ 关于" ToolTip="作者信息与检查更新" Style="{StaticResource Button.Base}"
                                Height="{StaticResource Size.ControlHeight}" Padding="16,0"
                                Margin="0,0,10,0"
                                Command="{Binding AboutCommand}" />
                        <Button Content="📋 日志" ToolTip="运行日志：扫描、启动、更新的记录，可复制或导出"
                                Style="{StaticResource Button.Base}"
                                Height="{StaticResource Size.ControlHeight}" Padding="16,0"
                                Margin="0,0,10,0"
                                Command="{Binding LogCommand}" />
                        <Button Content="⚙ 设置" ToolTip="设置" Style="{StaticResource Button.Base}"
                                Height="{StaticResource Size.ControlHeight}" Padding="16,0"
                                Command="{Binding SettingsCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═════════ 更新提示条：只有发现新版本时才出现 ═════════ -->
            <!-- ═════════ 提示条区：新版本 / 桌面可整理 ═════════ -->
            <StackPanel Grid.Row="2">
            <Border Background="{DynamicResource Brush.AccentSoft}"
                    BorderBrush="{DynamicResource Brush.AccentGlow}"
                    BorderThickness="0,0,0,1"
                    Padding="20,8"
                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="↑" FontSize="13" Margin="0,0,9,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Accent}" />
                        <TextBlock Text="{Binding UpdateBanner}" FontSize="12.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Accent}" />
                        <TextBlock Text="· 点右边「查看」可以下载并自动重启"
                                   FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextDim}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="查看" Height="26" Padding="16,0" Margin="0,0,8,0"
                                Style="{StaticResource Button.Accent}"
                                Click="ShowUpdate_Click" />
                        <Button Content="忽略" Height="26" Padding="14,0"
                                Click="DismissUpdate_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 桌面还能再干净一点：只在真的还有「已收录但没挪走」的快捷方式时出现 -->
            <Border Background="{DynamicResource Brush.SurfaceAlt}"
                    BorderBrush="{DynamicResource Brush.BorderSoft}"
                    BorderThickness="0,0,0,1"
                    Padding="20,8"
                    Visibility="{Binding HasTidyHint, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🧹" FontSize="13" Margin="0,0,9,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TidyBanner}" FontSize="12.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock Text="· 挪到备份文件夹，随时能还原"
                                   FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextDim}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="去整理" Height="26" Padding="16,0" Margin="0,0,8,0"
                                Style="{StaticResource Button.Accent}"
                                Click="ShowTidy_Click" />
                        <Button Content="忽略" Height="26" Padding="14,0"
                                Click="DismissTidy_Click" />
                    </StackPanel>
                </Grid>
            </Border>
            </StackPanel>

            <!-- ═════════ 主内容区 ═════════ -->
            <Grid Grid.Row="3">
                <!-- 卡片式（默认） -->
                <ScrollViewer Style="{StaticResource ScrollViewer.Clean}"
                              CanContentScroll="True"
                              Visibility="{Binding IsCardMode, Converter={StaticResource BoolToVis}}"
                              Padding="10,16,10,28">
                    <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource Card.Tile}"
                                  VirtualizingPanel.IsVirtualizing="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- 只生成视口里的那几行，游戏再多首屏也不变慢。
                                     CardWidth 直接取设置里的卡片宽度，面板第一轮就能算对列数 -->
                                <ctl:VirtualizingWrapPanel CardMargin="10"
                                                           CardWidth="{Binding Settings.CardWidth}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 列表式 -->
                <ScrollViewer Style="{StaticResource ScrollViewer.Clean}"
                              CanContentScroll="True"
                              Visibility="{Binding IsListMode, Converter={StaticResource BoolToVis}}"
                              Padding="20,16,20,28">
                    <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource Card.List}"
                                  VirtualizingPanel.IsVirtualizing="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ctl:VirtualizingWrapPanel FullWidth="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 空状态：一个游戏都没有 -->
                <Border Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource Brush.Scrim}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600">
                        <Border Width="104" Height="104" CornerRadius="26"
                                Background="{DynamicResource Brush.AccentGlow}"
                                HorizontalAlignment="Center" Opacity="0.9">
                            <Border.Effect>
                                <BlurEffect Radius="26" />
                            </Border.Effect>
                        </Border>
                        <TextBlock Text="🎮" FontSize="62" HorizontalAlignment="Center" Margin="0,-78,0,26" />
                        <TextBlock Text="游戏墙还是空的" Style="{StaticResource Text.Title}" FontSize="24"
                                   HorizontalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock Text="把散落在桌面上的游戏收进来，用封面墙的方式一眼找到它们。"
                                   Style="{StaticResource Text.Dim}" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,0,0,28" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="＋ 手动添加游戏" Style="{StaticResource Button.Accent}"
                                    Command="{Binding AddGameCommand}" Margin="0,0,12,0" Padding="22,0" Height="40" />
                            <Button Content="⟳ 自动扫描" Command="{Binding ScanCommand}" Padding="22,0" Height="40" Margin="0,0,12,0" />
                            <Button Content="⤓ 从平台导入" Command="{Binding ImportCommand}" Padding="22,0" Height="40" />
                        </StackPanel>

                        <TextBlock Text="提示：也可以把 .exe 或快捷方式直接拖进这个窗口，或按 Ctrl+V 粘贴路径。"
                                   Style="{StaticResource Text.Subtitle}"
                                   HorizontalAlignment="Center" Margin="0,24,0,0" />
                    </StackPanel>
                </Border>

                <!-- 空状态：筛选无结果 -->
                <Border Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource Brush.Scrim}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="没有匹配的游戏" Style="{StaticResource Text.Title}" FontSize="22"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="试试清空搜索关键词，或把标签切回「全部」。"
                                   Style="{StaticResource Text.Dim}" HorizontalAlignment="Center" Margin="0,12,0,22" />
                        <Button Content="清空筛选" Command="{Binding ClearFiltersCommand}"
                                HorizontalAlignment="Center" Padding="24,0" Height="38" />
                    </StackPanel>
                </Border>

                <!-- 忙碌遮罩 -->
                <Border Background="{DynamicResource Brush.ScrimStrong}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                        <ProgressBar IsIndeterminate="True" Width="240" Height="3"
                                     Foreground="{DynamicResource Brush.Accent}"
                                     Background="Transparent" BorderThickness="0" />
                        <TextBlock Text="{Binding BusyText}" Style="{StaticResource Text.Dim}"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" Margin="0,18,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═════════ 状态栏 ═════════ -->
            <Border Grid.Row="4"
                    Background="{DynamicResource Brush.BarGradient}"
                    BorderBrush="{DynamicResource Brush.BorderSoft}"
                    BorderThickness="0,1,0,0" Padding="20,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Subtitle}">
                            <Run Text="共 " />
                            <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Brush.Accent}" />
                            <Run Text=" 个游戏" />
                        </TextBlock>
                        <TextBlock Text="·" Style="{StaticResource Text.Subtitle}" Margin="10,0" />
                        <TextBlock Style="{StaticResource Text.Subtitle}">
                            <Run Text="当前显示 " />
                            <Run Text="{Binding VisibleCount, Mode=OneWay}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Brush.Accent}" />
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Subtitle}"
                               Text="双击启动 · 拖拽排序 · Ctrl+V 粘贴添加 · 右键更多操作" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
