<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 系统托盘 NotifyIcon 需要 WinForms 支持（仅用 NotifyIcon，界面全部是 WPF） -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GameWall</RootNamespace>
    <AssemblyName>GameWall</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 应用图标（窗口标题栏 / 任务栏 / exe 文件图标都用它） -->
    <ApplicationIcon>Assets\GameWall.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AssemblyTitle>GameWall</AssemblyTitle>
    <Product>GameWall</Product>
    <Description>A lightweight Windows game launcher with visual wall-style game management</Description>
    <!-- 作者信息：程序集里也会带上，右键 exe 属性 → 详细信息 里能看到 -->
    <Authors>季春二九 (jichun29)</Authors>
    <Company>季春二九</Company>
    <Copyright>© 2026 季春二九 (jichun29). MIT License.</Copyright>
    <RepositoryUrl>https://github.com/jichun29/GameWall-Launcher</RepositoryUrl>
    <PackageProjectUrl>https://github.com/jichun29/GameWall-Launcher</PackageProjectUrl>
    <Version>1.0.5</Version>
    <FileVersion>1.0.5.0</FileVersion>
    <InformationalVersion>1.0.5</InformationalVersion>
    <!--
      单文件发布参数（dotnet publish 时生效）。
      SelfContained=true 表示把 .NET 运行时一起打进去，用户机器不需要预装 .NET，双击即用。
      代价是体积会到 60MB 左右；想换成依赖框架的小体积版本，把它改成 false 即可
      （届时目标机需要安装 .NET 8 Desktop Runtime）。
    -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <!--
      WFAC010：UseWindowsForms 会建议把高 DPI 配置从 app.manifest 挪到 ApplicationHighDpiMode 属性。
      但本项目界面是 WPF，PerMonitorV2 必须由清单声明才生效，因此保留清单并静音该警告。
    -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      图标既作为 exe 文件图标（ApplicationIcon），也作为 WPF 资源打包，
      这样托盘图标可以直接从 pack:// 资源里取多尺寸版本，不依赖 exe 路径。
      logo-256.png 给界面里的品牌标识用（比从 ICO 里取更清晰）。
    -->
    <Resource Include="Assets\GameWall.ico" />
    <Resource Include="Assets\logo-256.png" />
  </ItemGroup>

  <ItemGroup>
    <!--
      UseWindowsForms 会自动注入 global using System.Windows.Forms / System.Drawing，
      这会让 Color、Brush、Point、MouseEventArgs、DragEventArgs 与 WPF 的同名类型冲突。
      这里把它们移除，代码里需要 WinForms 的地方一律写全限定名（如 System.Windows.Forms.NotifyIcon）。
    -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
