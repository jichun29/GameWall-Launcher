<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        浅色主题。键名与 Dark.xaml 一一对应，不能增删，
        否则 ThemeManager 切换时 DynamicResource 会找不到资源。
    -->

    <SolidColorBrush x:Key="Brush.Window" Color="#F4F6FA" />
    <SolidColorBrush x:Key="Brush.WindowBackdrop" Color="#F4F6FA" />

    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#EDF1F7" />
    <SolidColorBrush x:Key="Brush.Tooltip" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Brush.Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.CardHover" Color="#E7EDF7" />
    <LinearGradientBrush x:Key="Brush.CardOverlay" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#33000000" Offset="0.45" />
        <GradientStop Color="#B3000000" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Border" Color="#D3DAE5" />

    <SolidColorBrush x:Key="Brush.Text" Color="#18202B" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="#5A6675" />
    <SolidColorBrush x:Key="Brush.TextFaint" Color="#8C97A6" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#2563EB" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#282563EB" />

    <SolidColorBrush x:Key="Brush.Danger" Color="#D93B3B" />
    <SolidColorBrush x:Key="Brush.Success" Color="#16A34A" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#B45309" />

    <!-- 覆盖层：浅色下用白雾而不是黑幕 -->
    <SolidColorBrush x:Key="Brush.Scrim" Color="#F2F4F8" />
    <SolidColorBrush x:Key="Brush.ScrimStrong" Color="#F7F9FC" />

    <SolidColorBrush x:Key="Brush.CoverScrim" Color="#59000000" />

    <!-- 浅色下阴影要淡，否则卡片像蒙了层灰 -->
    <Color x:Key="Color.Shadow">#FF1B2735</Color>
    <sys:Double x:Key="Double.ShadowOpacity">0.14</sys:Double>

    <!-- 首次运行引导的顶部头图渐变：浅色下用蓝到白的柔和渐变 -->
    <Color x:Key="Color.HeroStart">#BBD3F5</Color>
    <Color x:Key="Color.HeroEnd">#F4F6FA</Color>
    <SolidColorBrush x:Key="Brush.HeroText" Color="#12233D" />
    <SolidColorBrush x:Key="Brush.HeroTextDim" Color="#4A5A6E" />

</ResourceDictionary>
